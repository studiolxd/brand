{
  "date-picker": {
    "height":                    { "$value": "{input.height}",                   "$type": "dimension", "$description": "Altura del disparador: la del campo de texto" },
    "sm-height":                 { "$value": "{input.sm-height}",                "$type": "dimension", "$description": "Altura — sm" },
    "lg-height":                 { "$value": "{input.lg-height}",                "$type": "dimension", "$description": "Altura — lg" },
    "padding-inline":            { "$value": "{input.padding-inline}",           "$type": "dimension", "$description": "Aire horizontal del disparador" },
    "sm-padding-inline":         { "$value": "{input.sm-padding-inline}",        "$type": "dimension", "$description": "Aire horizontal — sm" },
    "lg-padding-inline":         { "$value": "{input.lg-padding-inline}",        "$type": "dimension", "$description": "Aire horizontal — lg" },
    "font-family":               { "$value": "{input.font-family}",              "$type": "string",    "$description": "Familia tipográfica del disparador" },
    "font-size":                 { "$value": "{input.font-size}",                "$type": "dimension", "$description": "Tamaño de la fecha escrita" },
    "sm-font-size":              { "$value": "{input.sm-font-size}",             "$type": "dimension", "$description": "Tamaño — sm" },
    "lg-font-size":              { "$value": "{input.lg-font-size}",             "$type": "dimension", "$description": "Tamaño — lg" },
    "font-weight":               { "$value": "{input.font-weight}",              "$type": "number",    "$description": "Peso de la fecha escrita" },
    "line-height":               { "$value": "{input.line-height}",              "$type": "number",    "$description": "Interlineado del disparador" },
    "cursor":                    { "$value": "pointer",                          "$type": "string",    "$description": "Cursor: el disparador abre un calendario, no se escribe en él" },
    "color":                     { "$value": "{input.color}",                    "$type": "color",     "$description": "Color de la fecha escrita" },
    "placeholder-color":         { "$value": "{input.placeholder-color}",        "$type": "color",     "$description": "Color de la pista cuando no hay fecha" },
    "bg":                        { "$value": "{input.bg}",                       "$type": "color",     "$description": "Fondo del disparador" },
    "border-width":              { "$value": "{input.border-width}",             "$type": "dimension", "$description": "Grosor del borde" },
    "border-style":              { "$value": "{input.border-style}",             "$type": "string",    "$description": "Estilo del borde" },
    "border-color":              { "$value": "{input.border-color}",             "$type": "color",     "$description": "Color del borde" },
    "border-radius":             { "$value": "{input.border-radius}",            "$type": "dimension", "$description": "Radio del borde" },
    "transition-duration":       { "$value": "{input.transition-duration}",      "$type": "number",    "$description": "Duración de la transición de borde y anillo" },
    "transition-easing":         { "$value": "{input.transition-easing}",        "$type": "string",    "$description": "Curva de la transición" },
    "focus-border-color":        { "$value": "{input.focus-border-color}",       "$type": "color",     "$description": "Borde en foco" },
    "focus-ring-width":          { "$value": "{input.focus-ring-width}",         "$type": "dimension", "$description": "Grosor del anillo de foco" },
    "focus-ring-inset-offset":   { "$value": "{input.focus-ring-inset-offset}",  "$type": "dimension", "$description": "Separación entre borde y anillo de foco" },
    "focus-ring-color":          { "$value": "{input.focus-ring-color}",         "$type": "color",     "$description": "Color del anillo de foco" },
    "error-bg":                  { "$value": "{input.error-bg}",                 "$type": "color",     "$description": "Fondo en error" },
    "error-border-color":        { "$value": "{input.error-border-color}",       "$type": "color",     "$description": "Borde en error" },
    "error-focus-ring-color":    { "$value": "{input.error-focus-ring-color}",   "$type": "color",     "$description": "Anillo de foco en error" },
    "disabled-cursor":           { "$value": "{input.disabled-cursor}",          "$type": "string",    "$description": "Cursor deshabilitado" },
    "disabled-bg":               { "$value": "{input.disabled-bg}",              "$type": "color",     "$description": "Fondo deshabilitado" },
    "disabled-color":            { "$value": "{input.disabled-color}",           "$type": "color",     "$description": "Texto deshabilitado" },
    "disabled-border-color":     { "$value": "{input.disabled-border-color}",    "$type": "color",     "$description": "Borde deshabilitado" }
  }
}
