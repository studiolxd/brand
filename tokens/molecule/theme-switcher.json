{
  "theme-switcher": {
    "icon-gap":            { "$value": "{spacing.2}",             "$type": "dimension", "$description": "Entre el icono del tema y su nombre, en el menú y en la lista" },
    "list-gap":            { "$value": "{spacing.4}",             "$type": "dimension", "$description": "Separación entre temas en la lista desplegada" },
    "list-font-size":      { "$value": "{font-size.2}",           "$type": "dimension", "$description": "Temas en la lista" },
    "list-current-font-weight": { "$value": "{font-weight.emphasis}", "$type": "number", "$description": "Tema actual en la lista: solo cambia el peso" },
    "focus-ring-width":    { "$value": "{border-width.focus}",    "$type": "dimension", "$description": "Anillo de foco" },
    "focus-ring-offset":   { "$value": "{border-width.focus}",    "$type": "dimension", "$description": "Separación del anillo de foco" },
    "focus-ring-color":    { "$value": "{color.primary}",         "$type": "color",     "$description": "Anillo de foco" },
    "surface-dark-focus-ring-color": { "$value": "{color.text.on-dark}", "$type": "color", "$description": "Anillo de foco — surface-dark" }
  }
}
