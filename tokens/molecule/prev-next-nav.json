{
  "prev-next-nav": {
    "font-family":         { "$value": "{font-family.sans}",          "$type": "string",    "$description": "Font family" },
    "font-size":           { "$value": "{text.font-size}",            "$type": "dimension", "$description": "La variante md hereda el cuerpo de la superficie; la sm tiene talla propia" },
    "sm-font-size":        { "$value": "{font-size.1}",               "$type": "dimension", "$description": "14px — UI label (variante sm)" },
    "gap":                 { "$value": "{spacing.3}",                 "$type": "dimension", "$description": "Gap entre botones y label — variante md" },
    "sm-gap":              { "$value": "{spacing.2}",                 "$type": "dimension", "$description": "Gap entre botones y label — variante sm" },
    "eyebrow-font-size":   { "$value": "{text.paragraph.small.font-size}", "$type": "dimension", "$description": "Rótulo «Anterior»/«Siguiente» sobre el título del destino" },
    "eyebrow-color":       { "$value": "{color.text.muted-on-light}", "$type": "color",     "$description": "Color del rótulo de dirección" },
    "title-font-weight":   { "$value": "{font-weight.emphasis}",  "$type": "number",    "$description": "Peso del título del destino" },
    "title-color":         { "$value": "{color.text.on-light}",   "$type": "color",     "$description": "Color del título del destino" },
    "title-hover-color":   { "$value": "{color.primary}",         "$type": "color",     "$description": "Color del título del destino en hover" },
    "text-gap":            { "$value": "{spacing.1}",             "$type": "dimension", "$description": "Aire entre el rótulo de dirección y el título" },
    "label-font-weight":   { "$value": "{font-weight.emphasis}",        "$type": "number",    "$description": "Peso tipográfico del label central" },
    "label-color":         { "$value": "{color.text.on-light}",       "$type": "color",     "$description": "Color del label central" },
    "btn-color":           { "$value": "{color.text.on-light}",       "$type": "color",     "$description": "Color de los botones de navegación" },
    "btn-hover-color":     { "$value": "{color.primary}",             "$type": "color",     "$description": "Color en hover" },
    "btn-disabled-color":  { "$value": "{color.icon.secondary-on-light}", "$type": "color",     "$description": "Color cuando el botón está deshabilitado" },
    "focus-ring-color":    { "$value": "{color.primary}",             "$type": "color",     "$description": "Color del focus ring" },
    "focus-ring-radius":   { "$value": "{border-radius.default}",     "$type": "dimension", "$description": "Radio del anillo de foco — recto, como toda esquina del sistema" },
    "focus-ring-width":    { "$value": "{border-width.focus}",           "$type": "dimension", "$description": "Grosor del focus ring" },
    "focus-ring-offset":   { "$value": "{border-width.default}",           "$type": "dimension", "$description": "Separación del focus ring" },
    "transition-duration": { "$value": "{motion.duration.fast}",      "$type": "number",    "$description": "Duración de las transiciones" },
    "transition-easing":   { "$value": "{motion.easing.default}",     "$type": "string",    "$description": "Easing de las transiciones" },

    "surface-dark-eyebrow-color":      { "$value": "{color.text.muted-on-dark}", "$type": "color", "$description": "Color del rótulo de dirección — surface-dark" },
    "surface-dark-title-color":        { "$value": "{color.text.on-dark}", "$type": "color", "$description": "Color del título del destino — surface-dark" },
    "surface-dark-title-hover-color":  { "$value": "{color.accent-2}",     "$type": "color", "$description": "Color del título en hover — surface-dark: amarillo, porque el prusia de marca es aquí el fondo" },
    "surface-dark-label-color":        { "$value": "{color.text.on-dark}", "$type": "color", "$description": "Color del label central — surface-dark" },
    "surface-dark-btn-color":          { "$value": "{color.text.on-dark}", "$type": "color", "$description": "Color de los botones de navegación — surface-dark" },
    "surface-dark-btn-hover-color":    { "$value": "{color.accent-2}",     "$type": "color", "$description": "Color en hover — surface-dark: amarillo, porque el prusia de marca es aquí el fondo" },
    "surface-dark-btn-disabled-color": { "$value": "{color.text.muted-on-dark}",   "$type": "color", "$description": "Color del botón deshabilitado — surface-dark" },
    "surface-dark-focus-ring-color":   { "$value": "{color.text.on-dark}", "$type": "color", "$description": "Color del focus ring — surface-dark" }
  }
}
