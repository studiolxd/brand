{
  "dropdown-field": {
    "gap":             { "$value": "{spacing.2}",            "$type": "dimension", "$description": "Entre la etiqueta y el control, como en el resto de campos" },
    "height":          { "$value": "{control.height}",       "$type": "dimension", "$description": "El control mide la talla del sistema (md)" },
    "sm-height":       { "$value": "{size-component.sm}",    "$type": "dimension", "$description": "Altura — sm" },
    "lg-height":       { "$value": "{size-component.lg}",    "$type": "dimension", "$description": "Altura — lg" },
    "sm-font-size":    { "$value": "{select.sm-font-size}",  "$type": "dimension", "$description": "Cuerpo — sm (el del Select)" },
    "value-icon-size": { "$value": "{menu.item-icon-size}", "$type": "dimension", "$description": "Icono dentro del control: la misma talla que en las opciones del menú, para que plegado y desplegado casen" },
    "sm-value-icon-size": { "$value": "{menu.sm-item-icon-size}", "$type": "dimension", "$description": "Icono dentro del control — sm" },
    "lg-value-icon-size": { "$value": "{menu.lg-item-icon-size}", "$type": "dimension", "$description": "Icono dentro del control — lg" },
    "lg-font-size":    { "$value": "{select.lg-font-size}",  "$type": "dimension", "$description": "Cuerpo — lg (el del Select)" },
    "sm-padding-inline": { "$value": "{select.sm-padding-inline}", "$type": "dimension", "$description": "Padding inline — sm" },
    "lg-padding-inline": { "$value": "{select.lg-padding-inline}", "$type": "dimension", "$description": "Padding inline — lg" },
    "padding-inline":  { "$value": "{select.padding-inline}", "$type": "dimension", "$description": "Padding inline del control: el del Select" },
    "content-gap":     { "$value": "{spacing.2}",            "$type": "dimension", "$description": "Entre el contenido del control y el chevron" },
    "font-family":     { "$value": "{select.font-family}",   "$type": "string",    "$description": "Familia tipográfica: la del Select" },
    "font-size":       { "$value": "{select.font-size}",     "$type": "dimension", "$description": "Cuerpo: el del Select" },
    "font-weight":     { "$value": "{select.font-weight}",   "$type": "number",    "$description": "Peso: el del Select" },
    "color":           { "$value": "{select.color}",         "$type": "color",     "$description": "Texto del control" },
    "bg":              { "$value": "{select.bg}",            "$type": "color",     "$description": "Fondo del control" },
    "border-width":    { "$value": "{select.border-width}",  "$type": "dimension", "$description": "Borde rectangular, como el Select" },
    "border-color":    { "$value": "{select.border-color}",  "$type": "color",     "$description": "Color del borde" },
    "border-radius":   { "$value": "{select.border-radius}", "$type": "dimension", "$description": "Radio: el del Select (rectangular)" },
    "icon-transition": { "$value": "{select.icon-transition}", "$type": "number",  "$description": "Giro del chevron al abrir" },
    "focus-ring-width":  { "$value": "{select.focus-ring-width}",  "$type": "dimension", "$description": "Anillo de foco" },
    "focus-ring-color":  { "$value": "{select.focus-ring-color}",  "$type": "color",     "$description": "Anillo de foco" },
    "error-border-color":            { "$value": "{select.error-border-color}", "$type": "color", "$description": "Borde en error: el mismo que el del Select" },
    "surface-dark-error-border-color": { "$value": "{color.error-text-on-dark}", "$type": "color", "$description": "Borde en error — surface-dark" },
    "surface-dark-color":            { "$value": "{color.text.on-dark}",    "$type": "color", "$description": "Texto — surface-dark" },
    "surface-dark-bg":               { "$value": "{color.background.dark}", "$type": "color", "$description": "Fondo — surface-dark" },
    "surface-dark-border-color":     { "$value": "{color.text.on-dark}",    "$type": "color", "$description": "Borde — surface-dark" },
    "surface-dark-focus-ring-color": { "$value": "{color.text.on-dark}",    "$type": "color", "$description": "Anillo de foco — surface-dark" },

    "error": {
      "font-family":  { "$value": "{form.error.font-family}",  "$type": "string",    "$description": "Font family del mensaje de error" },
      "font-size":    { "$value": "{form.error.font-size}",    "$type": "dimension", "$description": "Font size del mensaje de error" },
      "font-weight":  { "$value": "{form.error.font-weight}",  "$type": "number",    "$description": "Font weight del mensaje de error" },
      "line-height":  { "$value": "{form.error.line-height}",  "$type": "number",    "$description": "Line height del mensaje de error" },
      "color":        { "$value": "{form.error.color}",        "$type": "color",     "$description": "Color del mensaje de error" },
      "surface-dark-color": { "$value": "{color.error-text-on-dark}", "$type": "color", "$description": "Color del mensaje de error — surface-dark" }
    },

    "helper": {
      "font-family":  { "$value": "{form.helper.font-family}",  "$type": "string",    "$description": "Font family del texto de ayuda" },
      "font-size":    { "$value": "{form.helper.font-size}",    "$type": "dimension", "$description": "Font size del texto de ayuda" },
      "font-weight":  { "$value": "{form.helper.font-weight}",  "$type": "number",    "$description": "Font weight del texto de ayuda" },
      "line-height":  { "$value": "{form.helper.line-height}",  "$type": "number",    "$description": "Line height del texto de ayuda" },
      "color":        { "$value": "{form.helper.color}",        "$type": "color",     "$description": "Color del texto de ayuda" },
      "surface-dark-color": { "$value": "{color.text.on-dark}", "$type": "color", "$description": "Color del texto de ayuda — surface-dark" }
    }
  }
}
