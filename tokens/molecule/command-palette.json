{
  "command-palette": {
    "max-height":          { "$value": "min(24rem, 60vh)",                  "$type": "dimension", "$description": "Alto máximo de la paleta — la lista scrollea dentro" },
    "input-padding-block": { "$value": "{spacing.3}",                       "$type": "dimension", "$description": "Padding vertical del buscador" },
    "input-padding-inline":{ "$value": "{spacing.2}",                       "$type": "dimension", "$description": "Padding horizontal del buscador" },
    "input-font-size":     { "$value": "{font-size.3}",                     "$type": "dimension", "$description": "Tamaño de texto del buscador" },
    "input-border-width":  { "$value": "{border-width.default}",                 "$type": "dimension", "$description": "Grosor de la línea bajo el buscador" },
    "input-border-color":  { "$value": "{floating-panel.border-color}",     "$type": "color",     "$description": "Color de la línea bajo el buscador" },
    "input-placeholder-color": { "$value": "{color.text.placeholder-on-light}",      "$type": "color",     "$description": "Color del placeholder del buscador" },
    "input-focus-ring-width":  { "$value": "{control.focus-ring-width}",     "$type": "dimension", "$description": "Grosor del anillo de foco del buscador — el del sistema" },
    "input-focus-ring-color":  { "$value": "{color.primary}",               "$type": "color",     "$description": "Color del anillo de foco del buscador" },
    "input-focus-border-color":{ "$value": "{color.primary}",               "$type": "color",     "$description": "Color de la línea bajo el buscador con el foco puesto" },
    "list-padding-block":  { "$value": "{spacing.1}",                       "$type": "dimension", "$description": "Padding vertical de la lista de resultados" },
    "list-padding-inline": { "$value": "{spacing.1}",                       "$type": "dimension", "$description": "Padding horizontal de la lista de resultados" },
    "empty-padding-block": { "$value": "{spacing.6}",                       "$type": "dimension", "$description": "Padding vertical del estado vacío" },
    "empty-padding-inline":{ "$value": "{spacing.4}",                       "$type": "dimension", "$description": "Padding horizontal del estado vacío" },
    "empty-font-size":     { "$value": "{font-size.2}",                     "$type": "dimension", "$description": "Tamaño de texto del estado vacío" },
    "empty-color":         { "$value": "{color.text.muted-on-light}",       "$type": "color",     "$description": "Color del estado vacío" },
    "heading-padding-block":  { "$value": "{spacing.2}",                    "$type": "dimension", "$description": "Padding vertical del título de grupo" },
    "heading-padding-inline": { "$value": "{spacing.3}",                    "$type": "dimension", "$description": "Padding horizontal del título de grupo" },
    "heading-font-size":   { "$value": "{font-size.1}",                     "$type": "dimension", "$description": "Tamaño de texto del título de grupo" },
    "heading-font-weight": { "$value": "{font-weight.emphasis}",              "$type": "number",    "$description": "Peso del título de grupo" },
    "heading-color":       { "$value": "{color.text.muted-on-light}",       "$type": "color",     "$description": "Color del título de grupo" },
    "item-padding-block":  { "$value": "{spacing.2}",                       "$type": "dimension", "$description": "Padding vertical de cada ítem" },
    "item-padding-inline": { "$value": "{spacing.3}",                       "$type": "dimension", "$description": "Padding horizontal de cada ítem" },
    "item-gap":            { "$value": "{spacing.2}",                       "$type": "dimension", "$description": "Gap entre icono y texto del ítem" },
    "item-border-radius":  { "$value": "{border-radius.default}",                "$type": "dimension", "$description": "Radio de cada ítem" },
    "item-font-size":      { "$value": "{font-size.2}",                     "$type": "dimension", "$description": "Tamaño de texto de los ítems" },
    "item-color":          { "$value": "{menu.item-color}",         "$type": "color",     "$description": "Color de texto de los ítems — comparte lenguaje con ContextMenu" },
    "item-highlighted-bg":    { "$value": "{menu.item-highlighted-bg}",    "$type": "color",     "$description": "Relleno del ítem resaltado — el del Menu: la inversión de marca" },
    "item-highlighted-color": { "$value": "{menu.item-highlighted-color}", "$type": "color",     "$description": "Texto del ítem resaltado — el del Menu: icono y atajo lo heredan por `currentColor`" },
    "item-icon-size":      { "$value": "{font-size.4}",                     "$type": "dimension", "$description": "Talla del icono de los ítems" },
    "surface-dark-empty-color":   { "$value": "{color.text.muted-on-dark}", "$type": "color",     "$description": "Color del estado vacío — surface-dark" },
    "surface-dark-heading-color": { "$value": "{color.text.muted-on-dark}", "$type": "color",     "$description": "Color del título de grupo — surface-dark" },
    "surface-dark-item-color":         { "$value": "{menu.surface-dark-item-color}",       "$type": "color", "$description": "Color de texto de los ítems — surface-dark" },
    "surface-dark-item-highlighted-bg":   { "$value": "{menu.surface-dark-item-highlighted-bg}",   "$type": "color", "$description": "Relleno del ítem resaltado — surface-dark" },
    "surface-dark-item-highlighted-color": { "$value": "{menu.surface-dark-item-highlighted-color}", "$type": "color", "$description": "Texto del ítem resaltado — surface-dark" },
    "surface-dark-input-placeholder-color":      { "$value": "{color.text.placeholder-on-dark}", "$type": "color", "$description": "Pista del buscador — surface-dark" },
    "surface-dark-input-focus-ring-color":       { "$value": "{color.text.on-dark}", "$type": "color", "$description": "Anillo de foco del buscador — surface-dark" },
    "surface-dark-input-focus-border-color":     { "$value": "{color.text.on-dark}", "$type": "color", "$description": "Línea bajo el buscador con el foco puesto — surface-dark" }
  }
}
