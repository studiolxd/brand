      "$type": "dimension",
      "$description": "Espacio entre label, control, helper y error"
    },
    "helper": {
      "font-family": {
        "$value": "{async-select-field.helper.font-family}",
        "$type": "string",
        "$description": "Font family del texto de ayuda"
      },
      "font-size": {
        "$value": "{async-select-field.helper.font-size}",
        "$type": "dimension",
        "$description": "Font size del texto de ayuda"
      },
      "font-weight": {
