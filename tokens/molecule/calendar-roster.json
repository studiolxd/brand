{
  "calendar-roster": {
    "font-family":               { "$value": "{font-family.sans}",          "$type": "string",    "$description": "Familia tipográfica base" },

    "radius":                    { "$value": "{border-radius.default}",      "$type": "dimension", "$description": "Radio del marco del cuadrante" },

    "border-color":              { "$value": "{color.primary}",           "$type": "color",     "$description": "Color de los bordes del grid" },
    "border-width":              { "$value": "{border-width.default}",            "$type": "dimension", "$description": "Grosor de los bordes del grid" },

    "th-name-width":             { "$value": "10rem",                        "$type": "dimension", "$description": "Ancho de la columna de nombre" },
    "th-name-font-size":         { "$value": "{font-size.1}",                "$type": "dimension", "$description": "Tamaño del encabezado de nombre" },
    "th-name-font-weight":       { "$value": "{font-weight.emphasis}",           "$type": "number",    "$description": "Peso del encabezado de nombre" },
    "th-name-color":             { "$value": "{color.text.muted-on-light}",  "$type": "color",     "$description": "Color del encabezado de nombre" },
    "th-name-bg":                { "$value": "{color.background.light}",     "$type": "color",     "$description": "Fondo sticky de la columna de nombre" },
    "th-name-padding-block":     { "$value": "{spacing.2}",                  "$type": "dimension", "$description": "Padding vertical del encabezado de nombre" },
    "th-name-padding-inline":    { "$value": "{spacing.3}",                  "$type": "dimension", "$description": "Padding horizontal del encabezado de nombre" },

    "th-day-width":              { "$value": "2.5rem",                       "$type": "dimension", "$description": "Ancho mínimo de cada columna de día" },
    "th-day-font-size":          { "$value": "{font-size.1}",                "$type": "dimension", "$description": "Tamaño del número de día" },
    "th-day-sub-font-size":      { "$value": "{font-size.0}",                "$type": "dimension", "$description": "Tamaño de la letra del día de semana" },
    "th-day-color":              { "$value": "{color.text.on-light}",        "$type": "color",     "$description": "Color del encabezado de día" },
    "th-day-padding-block":      { "$value": "{spacing.2}",                  "$type": "dimension", "$description": "Padding vertical del encabezado de día" },
    "th-day-bg":                 { "$value": "{color.background.light}",     "$type": "color",     "$description": "Fondo del encabezado de día" },

    "th-day-today-color":        { "$value": "{color.background.light}",     "$type": "color",     "$description": "Texto del encabezado del día de hoy" },
    "th-day-today-bg":           { "$value": "{color.primary}",              "$type": "color",     "$description": "Fondo del encabezado del día de hoy" },
    "th-day-today-radius":       { "$value": "{border-radius.default}",      "$type": "dimension", "$description": "Radio del badge del día de hoy" },
    "th-day-today-size":         { "$value": "{spacing.5}",                  "$type": "dimension", "$description": "Lado del badge del día de hoy" },

    "td-name-font-size":         { "$value": "{font-size.1}",                "$type": "dimension", "$description": "Tamaño del nombre del empleado" },
    "td-name-color":             { "$value": "{color.text.on-light}",        "$type": "color",     "$description": "Color del nombre del empleado" },
    "td-name-bg":                { "$value": "{color.background.light}",     "$type": "color",     "$description": "Fondo sticky de la celda de nombre" },
    "td-name-padding-block":     { "$value": "{spacing.2}",                  "$type": "dimension", "$description": "Padding vertical de la celda de nombre" },
    "td-name-padding-inline":    { "$value": "{spacing.3}",                  "$type": "dimension", "$description": "Padding horizontal de la celda de nombre" },

    "cell-padding-block":        { "$value": "{spacing.1}",                  "$type": "dimension", "$description": "Padding vertical de las celdas de datos" },
    "cell-padding-inline":       { "$value": "{spacing.1}",                  "$type": "dimension", "$description": "Padding horizontal de las celdas de datos" },
    "cell-bg":                   { "$value": "{color.background.light}",     "$type": "color",     "$description": "Fondo de celdas de día laborable" },
    "cell-weekend-bg":           { "$value": "{color.surface.secondary-on-light}", "$type": "color", "$description": "Fondo de celdas de fin de semana — superficie secundaria, la misma para todo día no laborable: lo que los distingue es el chip, no el gris" },
    "cell-holiday-bg":           { "$value": "{color.surface.secondary-on-light}", "$type": "color", "$description": "Fondo de celdas festivas — misma superficie secundaria; el festivo se nombra con su chip" },
    "cell-non-working-bg":       { "$value": "{color.surface.secondary-on-light}", "$type": "color", "$description": "Fondo de celdas no laborables (laborable sin turno asignado)" },
    "cell-today-outline-width":  { "$value": "{border-width.focus}",         "$type": "dimension", "$description": "Grosor del recuadro de la columna de hoy" },

    "schedule-font-size":        { "$value": "{font-size.0}",                "$type": "dimension", "$description": "Tamaño del texto de horario" },
    "schedule-color":            { "$value": "{color.text.on-light}",        "$type": "color",     "$description": "Color del texto de horario" },

    "legend-item-gap":           { "$value": "{spacing.1}",                  "$type": "dimension", "$description": "Gap entre el chip y su texto dentro de una entrada de la leyenda" },
    "legend-gap":                { "$value": "{spacing.3}",                  "$type": "dimension", "$description": "Gap entre elementos de la leyenda" },
    "legend-font-size":          { "$value": "{font-size.1}",                "$type": "dimension", "$description": "Tamaño del texto de la leyenda" },
    "legend-color":              { "$value": "{color.text.muted-on-light}",  "$type": "color",     "$description": "Color del texto de la leyenda" },
    "legend-swatch-size":        { "$value": "{spacing.3}",                  "$type": "dimension", "$description": "Tamaño del cuadradito de color en la leyenda" },
    "legend-swatch-radius":      { "$value": "{border-radius.default}",           "$type": "dimension", "$description": "Radio del cuadradito de color" },

    "surface-dark-border-color":         { "$value": "{color.text.on-dark}",  "$type": "color", "$description": "Color de bordes del grid — surface-dark" },
    "surface-dark-th-name-bg":           { "$value": "{color.background.dark}",    "$type": "color", "$description": "Fondo columna de nombre — surface-dark" },
    "surface-dark-th-name-color":        { "$value": "{color.text.muted-on-dark}", "$type": "color", "$description": "Color columna de nombre — surface-dark" },
    "surface-dark-th-day-color":         { "$value": "{color.text.on-dark}",       "$type": "color", "$description": "Color encabezado de día — surface-dark" },
    "surface-dark-th-day-bg":            { "$value": "{color.background.dark}",    "$type": "color", "$description": "Fondo encabezado de día — surface-dark" },
    "surface-dark-th-day-today-bg":      { "$value": "{color.text.on-dark}",       "$type": "color", "$description": "Fondo del día de hoy — surface-dark" },
    "surface-dark-th-day-today-color":   { "$value": "{color.background.dark}",    "$type": "color", "$description": "Texto del día de hoy — surface-dark" },
    "surface-dark-td-name-bg":           { "$value": "{color.background.dark}",    "$type": "color", "$description": "Fondo celda de nombre — surface-dark" },
    "surface-dark-td-name-color":        { "$value": "{color.text.on-dark}",       "$type": "color", "$description": "Color celda de nombre — surface-dark" },
    "surface-dark-cell-bg":              { "$value": "transparent",                "$type": "color", "$description": "Fondo de celdas — surface-dark" },
    "surface-dark-cell-weekend-bg":      { "$value": "{color.surface.secondary-on-dark}", "$type": "color", "$description": "Fondo fin de semana — surface-dark" },
    "surface-dark-cell-holiday-bg":      { "$value": "{color.surface.secondary-on-dark}", "$type": "color", "$description": "Fondo festivo — surface-dark" },
    "surface-dark-cell-non-working-bg":  { "$value": "{color.surface.secondary-on-dark}", "$type": "color", "$description": "Fondo no laborable — surface-dark" },
    "surface-dark-schedule-color":       { "$value": "{color.text.muted-on-dark}", "$type": "color", "$description": "Color del texto de horario — surface-dark" },
    "surface-dark-legend-color":         { "$value": "{color.text.muted-on-dark}", "$type": "color", "$description": "Color de la leyenda — surface-dark" }
  }
}
