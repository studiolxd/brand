{
  "language-switcher": {
    "code-font-size":      { "$value": "{font-size.1}",           "$type": "dimension", "$description": "El código de idioma en la barra (ES, EN)" },
    "code-font-weight":    { "$value": "{font-weight.emphasis}",  "$type": "number",    "$description": "El código: es una acción" },
    "code-letter-spacing": { "$value": "{letter-spacing.wide}",   "$type": "dimension", "$description": "El código, en mayúsculas" },
    "narrow-padding-inline": { "$value": "{select.sm-padding-inline}", "$type": "dimension", "$description": "Padding lateral del control compacto en teléfono (por debajo de sm): solo el código, sin chevron, para que quepa en la barra con marca y menú" },
    "list-gap":            { "$value": "{spacing.4}",             "$type": "dimension", "$description": "Separación entre idiomas en la lista desplegada" },
    "list-font-size":      { "$value": "{font-size.2}",           "$type": "dimension", "$description": "Idiomas en la lista" },
    "list-current-font-weight": { "$value": "{font-weight.emphasis}", "$type": "number", "$description": "Idioma actual en la lista: solo cambia el peso" },
    "focus-ring-width":    { "$value": "{border-width.focus}",    "$type": "dimension", "$description": "Anillo de foco" },
    "focus-ring-offset":   { "$value": "{border-width.focus}",    "$type": "dimension", "$description": "Separación del anillo de foco" },
    "focus-ring-color":    { "$value": "{color.primary}",         "$type": "color",     "$description": "Anillo de foco" },
    "surface-dark-focus-ring-color": { "$value": "{color.text.on-dark}", "$type": "color", "$description": "Anillo de foco — surface-dark" }
  }
}
