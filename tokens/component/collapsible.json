{
  "collapsible": {
    "trigger-gap":            { "$value": "{spacing.2}",              "$type": "dimension", "$description": "Separación entre el rótulo del disparador y su chevron" },
    "trigger-padding-block":  { "$value": "{spacing.2}",              "$type": "dimension", "$description": "Aire vertical del disparador" },
    "trigger-font-family":    { "$value": "{control.font-family}",    "$type": "string",    "$description": "Familia tipográfica del disparador" },
    "trigger-font-size":      { "$value": "{control.font-size}",      "$type": "dimension", "$description": "Tamaño de fuente del disparador" },
    "trigger-font-weight":    { "$value": "{control.font-weight}",    "$type": "number",    "$description": "Peso tipográfico del disparador" },
    "trigger-color":          { "$value": "{color.text.on-light}",    "$type": "color",     "$description": "Tinta del disparador" },
    "trigger-cursor":         { "$value": "pointer",                  "$type": "string",    "$description": "Cursor del disparador" },
    "disabled-cursor":        { "$value": "not-allowed",              "$type": "string",    "$description": "Cursor cuando está deshabilitado" },
    "disabled-opacity":       { "$value": "{opacity.disabled}",       "$type": "number",    "$description": "Opacidad cuando está deshabilitado" },
    "content-padding-block":  { "$value": "{spacing.2}",              "$type": "dimension", "$description": "Aire bajo el contenido plegable" },
    "transition-duration":    { "$value": "{motion.duration.fast}",   "$type": "duration",  "$description": "Duración de abrir y cerrar" },
    "transition-easing":      { "$value": "{motion.easing.default}",  "$type": "string",    "$description": "Easing de abrir y cerrar" },
    "focus-ring-width":       { "$value": "{border-width.focus}",     "$type": "dimension", "$description": "Grosor del anillo de foco" },
    "focus-ring-offset":      { "$value": "{border-width.default}",   "$type": "dimension", "$description": "Separación del anillo de foco" },
    "focus-ring-color":       { "$value": "{color.primary}",          "$type": "color",     "$description": "Color del anillo de foco" },
    "surface-dark-trigger-color":   { "$value": "{color.text.on-dark}", "$type": "color", "$description": "Tinta del disparador — surface-dark" },
    "surface-dark-focus-ring-color":{ "$value": "{color.text.on-dark}", "$type": "color", "$description": "Anillo de foco — surface-dark" }
  }
}
