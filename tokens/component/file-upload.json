{
  "file-upload": {
    "border-color":                { "$value": "{color.primary}",          "$type": "color",     "$description": "Borde del dropzone por defecto" },
    "border-style":                { "$value": "dashed",                      "$type": "string",    "$description": "Estilo de borde del dropzone" },
    "border-width":                { "$value": "{border-width.default}",           "$type": "dimension", "$description": "Grosor del borde" },
    "border-radius":               { "$value": "{border-radius.default}",          "$type": "dimension", "$description": "Radio de esquinas del dropzone" },
    "bg":                          { "$value": "{color.surface.secondary-on-light}", "$type": "color",     "$description": "Fondo del dropzone" },
    "padding-inline":              { "$value": "{spacing.5}",                 "$type": "dimension", "$description": "Padding horizontal del dropzone" },
    "gap":                         { "$value": "{spacing.1}",                 "$type": "dimension", "$description": "Espacio entre elementos dentro del dropzone" },
    "text-color":                  { "$value": "{color.text.on-light}",       "$type": "color",     "$description": "Color del texto principal" },
    "subtext-color":               { "$value": "{color.text.muted-on-light}", "$type": "color",     "$description": "Color del texto secundario y restricciones" },
    "icon-color":                  { "$value": "{color.text.on-light}",       "$type": "color",     "$description": "Color del icono upload" },
    "transition-duration":         { "$value": "{motion.duration.fast}",      "$type": "number",    "$description": "Duración de transiciones de estado" },
    "transition-easing":           { "$value": "{motion.easing.default}",     "$type": "string",    "$description": "Easing de transiciones" },

    "drag-border-color":           { "$value": "{color.primary}",             "$type": "color",     "$description": "Borde cuando hay drag activo" },
    "drag-border-style":           { "$value": "solid",                       "$type": "string",    "$description": "Estilo de borde en drag activo" },
    "drag-bg":                     { "$value": "{color.white}",               "$type": "color",     "$description": "Fondo en drag activo" },

    "error-border-color":          { "$value": "{color.error-text-on-light}",      "$type": "color",     "$description": "Borde en estado de error" },
    "error-border-style":          { "$value": "solid",                       "$type": "string",    "$description": "Estilo de borde en error" },
    "error-bg":                    { "$value": "{color.surface.secondary-on-light}", "$type": "color",     "$description": "Fondo en estado de error" },

    "disabled-opacity":            { "$value": "0.5",                         "$type": "number",    "$description": "Opacidad cuando está deshabilitado" },
    "disabled-cursor":             { "$value": "{input.disabled-cursor}",     "$type": "string",    "$description": "Cursor cuando está deshabilitado: el de los campos" },

    "list-gap":                    { "$value": "{spacing.2}",                 "$type": "dimension", "$description": "Espacio entre items de la lista" },
    "list-margin-block-start":     { "$value": "{spacing.3}",                 "$type": "dimension", "$description": "Margen superior de la lista de archivos" },

    "item-bg":                     { "$value": "{color.white}",               "$type": "color",     "$description": "Fondo de cada item" },
    "item-border-color":           { "$value": "{color.primary}",          "$type": "color",     "$description": "Borde de cada item" },
    "item-border-width":           { "$value": "{border-width.default}",           "$type": "dimension", "$description": "Grosor de borde del item" },
    "item-border-radius":          { "$value": "{border-radius.default}",          "$type": "dimension", "$description": "Radio de esquinas del item" },
    "item-padding-block":          { "$value": "{spacing.2}",                 "$type": "dimension", "$description": "Padding vertical del item" },
    "item-padding-inline":         { "$value": "{spacing.3}",                 "$type": "dimension", "$description": "Padding horizontal del item" },
    "item-gap":                    { "$value": "{spacing.3}",                 "$type": "dimension", "$description": "Espacio entre thumb, info y botón" },
    "item-name-font-family":       { "$value": "{font-family.sans}",          "$type": "string",    "$description": "Fuente del nombre de archivo" },
    "item-name-font-size":         { "$value": "{text.font-size}",            "$type": "dimension", "$description": "El nombre de archivo hereda el cuerpo de la superficie" },
    "item-name-font-weight":       { "$value": "{font-weight.default}",       "$type": "number",    "$description": "Peso del nombre de archivo" },
    "item-name-color":             { "$value": "{color.text.on-light}",       "$type": "color",     "$description": "Color del nombre de archivo" },
    "item-size-font-size":         { "$value": "{font-size.1}",               "$type": "dimension", "$description": "Tamaño del peso del archivo" },
    "item-size-color":             { "$value": "{color.text.muted-on-light}", "$type": "color",     "$description": "Color del peso del archivo" },
    "item-error-color":            { "$value": "{color.error-text-on-light}",      "$type": "color",     "$description": "Color del mensaje de error por archivo" },
    "item-error-font-size":        { "$value": "{font-size.1}",               "$type": "dimension", "$description": "Tamaño del mensaje de error por archivo" },

    "item-error-border-color":     { "$value": "{color.error-text-on-light}",      "$type": "color",     "$description": "Borde del item con error" },
    "item-error-bg":               { "$value": "{color.white}",               "$type": "color",     "$description": "Fondo del item con error" },

    "thumb-size":                  { "$value": "{size-component.md}",         "$type": "dimension", "$description": "Lado de la miniatura: la talla md del sistema (el mismo 2.5rem de antes, ahora con nombre)" },
    "thumb-border-radius":         { "$value": "{border-radius.default}",          "$type": "dimension", "$description": "Radio del thumbnail" },
    "thumb-bg":                    { "$value": "{color.surface.secondary-on-light}", "$type": "color",     "$description": "Fondo del thumb para iconos (no imagen)" },
    "thumb-icon-color":            { "$value": "{color.icon.secondary-on-light}",   "$type": "color",     "$description": "Color del icono de archivo genérico" },

    "remove-color":                { "$value": "{color.text.muted-on-light}", "$type": "color",     "$description": "Color del botón eliminar" },
    "remove-color-hover":          { "$value": "{color.error-text-on-light}",      "$type": "color",     "$description": "Color del botón eliminar al hacer hover" },

    "progress-margin-block-start": { "$value": "{spacing.3}",                 "$type": "dimension", "$description": "Margen superior de la barra de progreso" },
    "surface-dark-border-color":                 { "$value": "{color.text.on-dark}", "$type": "color", "$description": "Borde del dropzone — surface-dark: la tinta de la superficie" },
    "surface-dark-bg":                           { "$value": "{color.surface.secondary-on-dark}", "$type": "color", "$description": "Fondo del dropzone — surface-dark: la superficie secundaria oscura" },
    "surface-dark-text-color":                   { "$value": "{color.text.on-dark}", "$type": "color", "$description": "Texto principal — surface-dark" },
    "surface-dark-subtext-color":                { "$value": "{color.text.muted-on-dark}", "$type": "color", "$description": "Texto secundario — surface-dark" },
    "surface-dark-icon-color":                   { "$value": "{color.text.on-dark}", "$type": "color", "$description": "Icono de subida — surface-dark" },
    "surface-dark-drag-border-color":            { "$value": "{color.text.on-dark}", "$type": "color", "$description": "Borde con arrastre activo — surface-dark" },
    "surface-dark-drag-bg":                      { "$value": "{color.background.dark}", "$type": "color", "$description": "Fondo con arrastre activo — surface-dark: el lienzo, para que el dropzone se vacíe igual que en claro" },
    "surface-dark-error-border-color":           { "$value": "{color.error-text-on-dark}", "$type": "color", "$description": "Borde en error — surface-dark" },
    "surface-dark-error-bg":                     { "$value": "{color.surface.secondary-on-dark}", "$type": "color", "$description": "Fondo en error — surface-dark" },
    "surface-dark-item-bg":                      { "$value": "{color.background.dark}", "$type": "color", "$description": "Fondo de cada archivo — surface-dark" },
    "surface-dark-item-border-color":            { "$value": "{color.text.on-dark}", "$type": "color", "$description": "Borde de cada archivo — surface-dark" },
    "surface-dark-item-name-color":              { "$value": "{color.text.on-dark}", "$type": "color", "$description": "Nombre del archivo — surface-dark" },
    "surface-dark-item-size-color":              { "$value": "{color.text.muted-on-dark}", "$type": "color", "$description": "Peso del archivo — surface-dark" },
    "surface-dark-item-error-color":             { "$value": "{color.error-text-on-dark}", "$type": "color", "$description": "Mensaje de error por archivo — surface-dark" },
    "surface-dark-item-error-border-color":      { "$value": "{color.error-text-on-dark}", "$type": "color", "$description": "Borde del archivo con error — surface-dark" },
    "surface-dark-item-error-bg":                { "$value": "{color.background.dark}", "$type": "color", "$description": "Fondo del archivo con error — surface-dark" },
    "surface-dark-thumb-bg":                     { "$value": "{color.surface.secondary-on-dark}", "$type": "color", "$description": "Fondo de la miniatura — surface-dark" },
    "surface-dark-thumb-icon-color":             { "$value": "{color.text.muted-on-dark}", "$type": "color", "$description": "Icono de archivo genérico — surface-dark: `grey-dark` no llega a 3:1 sobre prusia" },
    "surface-dark-remove-color":                 { "$value": "{color.text.muted-on-dark}", "$type": "color", "$description": "Aspa de quitar — surface-dark" },
    "surface-dark-remove-color-hover":           { "$value": "{color.error-text-on-dark}", "$type": "color", "$description": "Aspa de quitar, bajo el puntero — surface-dark" },
    "padding-block":              { "$value": "{spacing.7}", "$type": "dimension", "$description": "Aire vertical del dropzone — talla md" },
    "sm-padding-block":           { "$value": "{spacing.6}", "$type": "dimension", "$description": "Aire vertical del dropzone — talla sm" },
    "lg-padding-block":           { "$value": "{spacing.8}", "$type": "dimension", "$description": "Aire vertical del dropzone — talla lg" },
    "sm-padding-inline":          { "$value": "{spacing.4}", "$type": "dimension", "$description": "Aire horizontal del dropzone — talla sm" },
    "lg-padding-inline":          { "$value": "{spacing.6}", "$type": "dimension", "$description": "Aire horizontal del dropzone — talla lg" },
    "text-font-family":           { "$value": "{font-family.sans}", "$type": "string", "$description": "Tipografía del texto del dropzone" },
    "text-font-size":             { "$value": "{text.font-size}", "$type": "dimension", "$description": "El texto del dropzone es texto corriente: hereda el cuerpo de la superficie — talla md" },
    "sm-text-font-size":          { "$value": "{text.paragraph.small.font-size}", "$type": "dimension", "$description": "Texto del dropzone — talla sm: un peldaño por debajo del cuerpo" },
    "lg-text-font-size":          { "$value": "{text.paragraph.large.font-size}", "$type": "dimension", "$description": "Texto del dropzone — talla lg: un peldaño por encima" },
    "text-font-weight":           { "$value": "{font-weight.default}", "$type": "number", "$description": "Peso del texto del dropzone" },
    "subtext-font-weight":        { "$value": "{font-weight.default}", "$type": "number", "$description": "Peso del texto secundario del dropzone: el normal, para que no compita con la instrucción" },
    "subtext-font-size":          { "$value": "{font-size.1}", "$type": "dimension", "$description": "Tamaño de las restricciones (peso máximo, número de archivos) — talla md" },
    "sm-subtext-font-size":       { "$value": "{font-size.1}", "$type": "dimension", "$description": "Restricciones — talla sm: ya está en el peldaño menor de la escala de interfaz" },
    "lg-subtext-font-size":       { "$value": "{text.font-size}", "$type": "dimension", "$description": "Restricciones — talla lg: sube al cuerpo" },
    "sm-thumb-size":              { "$value": "{size-component.sm}", "$type": "dimension", "$description": "Lado de la miniatura — talla sm" },
    "lg-thumb-size":              { "$value": "{size-component.lg}", "$type": "dimension", "$description": "Lado de la miniatura — talla lg" },
    "sm-item-name-font-size":     { "$value": "{text.paragraph.small.font-size}", "$type": "dimension", "$description": "Nombre del archivo — talla sm" },
    "lg-item-name-font-size":     { "$value": "{text.paragraph.large.font-size}", "$type": "dimension", "$description": "Nombre del archivo — talla lg" },
    "item-info-gap":              { "$value": "{spacing.1}", "$type": "dimension", "$description": "Aire entre el nombre del archivo y su peso (antes 2px, fuera de la escala)" },
    "border-dash-length":         { "$value": "{spacing.4}", "$type": "dimension", "$description": "Largo de cada trazo del borde discontinuo del dropzone" },
    "border-dash-gap":            { "$value": "{spacing.2}", "$type": "dimension", "$description": "Hueco entre trazos del borde discontinuo (antes 10px, fuera de la escala)" },
    "remove-focus-ring-offset":   { "$value": "{border-width.default}", "$type": "dimension", "$description": "Separación del anillo de foco del aspa" },
    "remove-border-radius":       { "$value": "{border-radius.default}", "$type": "dimension", "$description": "Radio del aspa — recto, como toda esquina del sistema" }
  }
}
