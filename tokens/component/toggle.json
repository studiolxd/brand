{
  "toggle": {
    "height":              { "$value": "{size-component.md}",       "$type": "dimension", "$description": "Altura del botón (talla md)" },
    "sm-height":           { "$value": "{size-component.sm}",       "$type": "dimension", "$description": "Altura — talla sm" },
    "lg-height":           { "$value": "{size-component.lg}",       "$type": "dimension", "$description": "Altura — talla lg" },
    "padding-inline":      { "$value": "{spacing.5}",               "$type": "dimension", "$description": "Padding inline" },
    "sm-padding-inline":   { "$value": "{spacing.4}",               "$type": "dimension", "$description": "Padding inline — talla sm" },
    "lg-padding-inline":   { "$value": "{spacing.6}",               "$type": "dimension", "$description": "Padding inline — talla lg" },
    "gap":                 { "$value": "{spacing.2}",               "$type": "dimension", "$description": "Separación entre el icono y el texto" },
    "font-family":         { "$value": "{control.font-family}",     "$type": "string",    "$description": "Familia tipográfica" },
    "font-size":           { "$value": "{control.font-size}",       "$type": "dimension", "$description": "Tamaño de fuente" },
    "sm-font-size":        { "$value": "{font-size.1}",             "$type": "dimension", "$description": "Tamaño de fuente — talla sm" },
    "lg-font-size":        { "$value": "{font-size.3}",             "$type": "dimension", "$description": "Tamaño de fuente — talla lg" },
    "font-weight":         { "$value": "{control.font-weight}",     "$type": "number",    "$description": "Peso tipográfico" },
    "line-height":         { "$value": "{control.line-height}",     "$type": "number",    "$description": "Interlineado" },
    "border-width":        { "$value": "{control.border-width}",    "$type": "dimension", "$description": "Grosor del borde" },
    "border-style":        { "$value": "{control.border-style}",    "$type": "string",    "$description": "Estilo del borde" },
    "border-radius":       { "$value": "{control.border-radius}",   "$type": "dimension", "$description": "Radio del borde (recto, como el resto de controles)" },
    "border-color":        { "$value": "{color.icon.secondary-on-light}", "$type": "color",     "$description": "Borde sin pulsar. Es el contorno de un control, no un divisor: el gris de bordes se queda en 1.54:1 sobre blanco y WCAG 1.4.11 pide 3:1. El gris de acción secundaria cumple y deja sitio al paso de hover, que sí es prusia" },
    "bg":                  { "$value": "transparent",               "$type": "color",     "$description": "Fondo sin pulsar: ninguno. El relleno es lo que dice que el valor está elegido" },
    "color":               { "$value": "{color.text.on-light}",     "$type": "color",     "$description": "Texto sin pulsar" },
    "hover-border-color":  { "$value": "{color.primary}",           "$type": "color",     "$description": "Borde al pasar el ratón — el hover no pone fondo, solo marca el borde" },
    "pressed-bg":          { "$value": "{color.primary}",           "$type": "color",     "$description": "Fondo pulsado: el valor elegido" },
    "pressed-color":       { "$value": "{color.text.on-dark}",      "$type": "color",     "$description": "Texto pulsado" },
    "pressed-border-color":{ "$value": "{color.primary}",           "$type": "color",     "$description": "Borde pulsado" },
    "cursor":              { "$value": "pointer",                   "$type": "string",    "$description": "Cursor" },
    "disabled-cursor":     { "$value": "not-allowed",               "$type": "string",    "$description": "Cursor cuando está deshabilitado" },
    "disabled-opacity":    { "$value": "{opacity.disabled}",        "$type": "number",    "$description": "Opacidad cuando está deshabilitado" },
    "transition-duration": { "$value": "{motion.duration.fast}",    "$type": "duration",  "$description": "Duración de la transición" },
    "transition-easing":   { "$value": "{motion.easing.default}",   "$type": "string",    "$description": "Easing de la transición" },
    "focus-ring-width":    { "$value": "{border-width.focus}",      "$type": "dimension", "$description": "Grosor del anillo de foco" },
    "focus-ring-offset":   { "$value": "{spacing.1}",               "$type": "dimension", "$description": "Separación del anillo de foco" },
    "focus-ring-color":    { "$value": "{color.primary}",           "$type": "color",     "$description": "Color del anillo de foco" },
    "surface-dark-border-color":         { "$value": "{color.text.on-dark}", "$type": "color", "$description": "Borde sin pulsar — surface-dark" },
    "surface-dark-color":                { "$value": "{color.text.on-dark}", "$type": "color", "$description": "Texto sin pulsar — surface-dark" },
    "surface-dark-hover-border-color":   { "$value": "{color.accent-1}",     "$type": "color", "$description": "Borde al pasar el ratón — surface-dark" },
    "surface-dark-pressed-bg":           { "$value": "{color.accent-1}",     "$type": "color", "$description": "Fondo pulsado — surface-dark. El prusia coincide con el fondo de la superficie; el par es el de `Button primary`" },
    "surface-dark-pressed-color":        { "$value": "{color.primary}",      "$type": "color", "$description": "Texto pulsado — surface-dark" },
    "surface-dark-pressed-border-color": { "$value": "{color.accent-1}",     "$type": "color", "$description": "Borde pulsado — surface-dark" },
    "surface-dark-focus-ring-color":     { "$value": "{color.text.on-dark}", "$type": "color", "$description": "Anillo de foco — surface-dark" }
  }
}
