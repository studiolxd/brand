{
  "scroll-area": {
    "scrollbar-size":       { "$value": "{spacing.2}",              "$type": "dimension", "$description": "Grosor de la barra de desplazamiento" },
    "scrollbar-bg":         { "$value": "transparent",              "$type": "color",     "$description": "Carril de la barra: sin relleno, la barra es el pulgar" },
    "thumb-bg":             { "$value": "{color.grey-light}",       "$type": "color",     "$description": "Pulgar de la barra" },
    "thumb-hover-bg":       { "$value": "{color.grey-dark}",        "$type": "color",     "$description": "Pulgar al pasar el ratón o arrastrarlo" },
    "thumb-border-radius":  { "$value": "{border-radius.default}",  "$type": "dimension", "$description": "Radio del pulgar (recto, como el resto del sistema)" },
    "transition-duration":  { "$value": "{motion.duration.fast}",   "$type": "duration",  "$description": "Duración de la aparición de la barra" },
    "transition-easing":    { "$value": "{motion.easing.default}",  "$type": "string",    "$description": "Easing de la aparición de la barra" },
    "focus-ring-width":     { "$value": "{border-width.focus}",     "$type": "dimension", "$description": "Grosor del anillo de foco del área desplazable" },
    "focus-ring-offset":    { "$value": "{border-width.default}",   "$type": "dimension", "$description": "Separación del anillo de foco" },
    "focus-ring-color":     { "$value": "{color.primary}",          "$type": "color",     "$description": "Color del anillo de foco" },
    "surface-dark-thumb-bg":         { "$value": "{color.text.on-dark}", "$type": "color", "$description": "Pulgar — surface-dark" },
    "surface-dark-thumb-hover-bg":   { "$value": "{color.accent-1}",     "$type": "color", "$description": "Pulgar señalado — surface-dark" },
    "surface-dark-focus-ring-color": { "$value": "{color.text.on-dark}", "$type": "color", "$description": "Anillo de foco — surface-dark" }
  }
}
