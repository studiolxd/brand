{
  "spinner": {
    "size-sm":          { "$value": "{spacing.4}", "$type": "dimension", "$description": "16px — compact spinner" },
    "size-md":          { "$value": "{spacing.5}", "$type": "dimension", "$description": "24px — default spinner" },
    "size-lg":          { "$value": "{spacing.6}", "$type": "dimension", "$description": "32px — large spinner" },
    "border-width-sm":  { "$value": "2px",         "$type": "dimension", "$description": "Grosor del trazo (stroke) para sm" },
    "border-width-md":  { "$value": "2px",         "$type": "dimension", "$description": "Grosor del trazo (stroke) para md" },
    "border-width-lg":  { "$value": "3px",         "$type": "dimension", "$description": "Grosor del trazo (stroke) para lg" },
    "animation-duration": { "$value": "1000ms",    "$type": "number",    "$description": "Tiempo en dibujar el contorno completo (un ciclo del bucle)" }
  }
}
