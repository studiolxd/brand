{
  "tag": {
    "border-radius":  { "$value": "{border-radius.round}",   "$type": "dimension", "$description": "Píldora: el tag es una de las formas redondas del sistema" },
    "font-family":    { "$value": "{font-family.sans}",      "$type": "string",    "$description": "Tipografía" },
    "font-size":      { "$value": "{font-size.1}",           "$type": "dimension", "$description": "14px — cuerpo de interfaz, no de prosa" },
    "font-weight":    { "$value": "{font-weight.emphasis}",  "$type": "number",    "$description": "Peso de énfasis" },
    "line-height":    { "$value": "{line-height.none}",      "$type": "number",    "$description": "Una línea" },
    "padding-block":  { "$value": "{spacing.1}",             "$type": "dimension", "$description": "Aire vertical" },
    "padding-inline": { "$value": "{spacing.3}",             "$type": "dimension", "$description": "Aire horizontal" },

    "primary-bg":       { "$value": "{color.primary}",         "$type": "color", "$description": "Marca primaria (prusia) — relleno" },
    "primary-color":    { "$value": "{color.text.on-dark}",    "$type": "color", "$description": "Marca primaria — texto sobre el relleno" },
    "surface-dark-primary-bg":    { "$value": "{color.text.on-dark}",   "$type": "color", "$description": "Marca primaria, relleno — surface-dark (invertido: el prusia es el fondo de la superficie y el tag desaparecería)" },
    "surface-dark-primary-color": { "$value": "{color.background.dark}", "$type": "color", "$description": "Marca primaria, texto — surface-dark (invertido)" },
    "accent-1-bg":     { "$value": "{color.accent-1}",       "$type": "color", "$description": "Acento 1 (lavanda) — relleno" },
    "accent-1-color":  { "$value": "{color.text.on-light}",  "$type": "color", "$description": "Acento 1 — texto sobre el relleno" },
    "accent-2-bg":     { "$value": "{color.accent-2}",       "$type": "color", "$description": "Acento 2 (amarillo) — relleno" },
    "accent-2-color":  { "$value": "{color.text.on-light}",  "$type": "color", "$description": "Acento 2 — texto sobre el relleno" },
    "support-1-bg":    { "$value": "{color.support-1}",      "$type": "color", "$description": "Soporte 1 (esmeralda) — relleno" },
    "support-1-color": { "$value": "{color.text.on-light}",  "$type": "color", "$description": "Soporte 1 — texto sobre el relleno" },
    "support-2-bg":    { "$value": "{color.support-2}",      "$type": "color", "$description": "Soporte 2 (cayena) — relleno" },
    "support-2-color": { "$value": "{color.text.on-light}",  "$type": "color", "$description": "Soporte 2 — texto sobre el relleno" },

    "neutral-bg":    { "$value": "{color.grey-darkest}",     "$type": "color", "$description": "Neutral — relleno gris oscuro (AAA con texto blanco)" },
    "neutral-color": { "$value": "{color.text.on-dark}",     "$type": "color", "$description": "Neutral — texto sobre el relleno" },
    "info-bg":       { "$value": "{color.primary}",          "$type": "color", "$description": "Información — relleno prusia (AAA con texto blanco)" },
    "info-color":    { "$value": "{color.text.on-dark}",     "$type": "color", "$description": "Información — texto sobre el relleno" },
    "surface-dark-info-bg":    { "$value": "{color.text.on-dark}",   "$type": "color", "$description": "Información, relleno — surface-dark (invertido, misma razón que primary)" },
    "surface-dark-info-color": { "$value": "{color.background.dark}", "$type": "color", "$description": "Información, texto — surface-dark (invertido)" },
    "warning-bg":    { "$value": "{color.accent-2}",         "$type": "color", "$description": "Aviso — relleno amarillo de marca (AAA con texto prusia)" },
    "warning-color": { "$value": "{color.text.on-light}",    "$type": "color", "$description": "Aviso — texto sobre el relleno" },
    "success-bg":    { "$value": "{color.success-fill}",     "$type": "color", "$description": "Éxito — relleno universal del sistema" },
    "success-color": { "$value": "{color.success-fill-text}", "$type": "color", "$description": "Éxito — contenido sobre el relleno" },
    "danger-bg":     { "$value": "{color.error-fill}",       "$type": "color", "$description": "Peligro — relleno universal del sistema" },
    "danger-color":  { "$value": "{color.error-fill-text}",  "$type": "color", "$description": "Peligro — contenido sobre el relleno" }
  }
}
