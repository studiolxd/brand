{
  "org-switcher": {
    "trigger-padding-block":  { "$value": "{spacing.2}",                   "$type": "dimension", "$description": "Padding vertical del trigger" },
    "trigger-padding-inline": { "$value": "{spacing.3}",                   "$type": "dimension", "$description": "Padding horizontal del trigger" },
    "trigger-gap":            { "$value": "{spacing.3}",                   "$type": "dimension", "$description": "Espacio entre logo y nombre" },
    "trigger-border-radius":  { "$value": "{border-radius.default}",            "$type": "dimension", "$description": "Radio del trigger" },
    "trigger-hover-bg":       { "$value": "transparent",                   "$type": "color",     "$description": "Fondo del trigger al hover — sin fondo, estilo ghost" },
    "focus-ring-color":       { "$value": "{color.primary}",               "$type": "color",     "$description": "Color del focus ring" },
    "focus-ring-width":       { "$value": "{border-width.focus}",             "$type": "dimension", "$description": "Grosor del focus ring" },
    "focus-ring-offset":      { "$value": "{border-width.default}",             "$type": "dimension", "$description": "Separación del focus ring" },
    "name-font-size":         { "$value": "{font-size.2}",                 "$type": "dimension", "$description": "Tamaño de texto del nombre de la org" },
    "name-font-weight":       { "$value": "{font-weight.emphasis}",          "$type": "number",    "$description": "Peso del nombre de la org" },
    "name-color":             { "$value": "{color.text.on-light}",         "$type": "color",     "$description": "Color del nombre de la org" },
    "content-min-width":      { "$value": "14rem",                         "$type": "dimension", "$description": "Ancho mínimo del panel: nombres de organización (no es una talla de componente)" },
    "content-bg":             { "$value": "{floating-panel.bg}",           "$type": "color",     "$description": "Fondo del panel" },
    "content-border-width":   { "$value": "{floating-panel.border-width}", "$type": "dimension", "$description": "Borde del panel" },
    "content-border-color":   { "$value": "{floating-panel.border-color}", "$type": "color",     "$description": "Color del borde del panel" },
    "content-border-radius":  { "$value": "{floating-panel.border-radius}","$type": "dimension", "$description": "Radio del panel" },
    "content-shadow":         { "$value": "{floating-panel.shadow}",       "$type": "shadow",    "$description": "Sombra del panel" },
    "content-z-index":        { "$value": "{floating-panel.z-index}",      "$type": "number",    "$description": "Z-index del dropdown (por encima del sidebar en mobile)" },
    "content-padding-block":  { "$value": "{spacing.2}",                   "$type": "dimension", "$description": "Padding vertical del panel" },
    "content-padding-inline": { "$value": "{spacing.2}",                   "$type": "dimension", "$description": "Padding horizontal del panel" },
    "item-padding-block":     { "$value": "{spacing.2}",                   "$type": "dimension", "$description": "Padding vertical de cada ítem" },
    "item-padding-inline":    { "$value": "{spacing.3}",                   "$type": "dimension", "$description": "Padding horizontal de cada ítem" },
    "item-border-radius":     { "$value": "{border-radius.default}",            "$type": "dimension", "$description": "Radio de cada ítem" },
    "item-font-size":         { "$value": "{font-size.2}",                 "$type": "dimension", "$description": "Tamaño de texto de ítems" },
    "item-font-weight":       { "$value": "{font-weight.default}",         "$type": "number",    "$description": "Peso de ítems" },
    "item-color":             { "$value": "{color.text.on-light}",         "$type": "color",     "$description": "Color de ítems" },
    "item-hover-bg":          { "$value": "{menu.item-hover-bg}",         "$type": "color",     "$description": "Fondo de ítem al hover: el resalte de los menús" },
    "item-hover-color":       { "$value": "{menu.item-hover-color}",      "$type": "color",     "$description": "Texto de ítem al hover" },
    "surface-dark-item-hover-color": { "$value": "{menu.surface-dark-item-hover-color}", "$type": "color", "$description": "Texto de ítem al hover — surface-dark" },
    "separator-color":        { "$value": "{separator.color}",            "$type": "color",     "$description": "Color del separador — el de la línea del sistema" },
    "separator-height":       { "$value": "{separator.thickness}",             "$type": "dimension", "$description": "Alto del separador — el grosor de la línea del sistema" },
    "separator-margin-block": { "$value": "{separator.spacing-md}",                   "$type": "dimension", "$description": "Margen vertical del separador — el aire md de la línea del sistema" },
    "transition-duration":    { "$value": "{floating-panel.transition-duration}", "$type": "number",    "$description": "Duración de transición" },
    "transition-easing":      { "$value": "{floating-panel.transition-easing}",   "$type": "string",    "$description": "Easing de transición" },
    "surface-dark-trigger-hover-bg":  { "$value": "transparent",               "$type": "color", "$description": "Fondo del trigger al hover — surface-dark, sin fondo (igual que en claro)" },
    "surface-dark-focus-ring-color":  { "$value": "{color.text.on-dark}",      "$type": "color", "$description": "Focus ring color — surface-dark. `focus-ring-color` (prussian) sería invisible sobre fondo oscuro." },
    "surface-dark-name-color":        { "$value": "{color.text.on-dark}",      "$type": "color", "$description": "Color del nombre de la org — surface-dark. `name-color` (on-light/prussian) sería ilegible sobre fondo oscuro." },
    "surface-dark-item-color":        { "$value": "{color.text.on-dark}",      "$type": "color", "$description": "Color de ítems — surface-dark" },
    "surface-dark-item-hover-bg":     { "$value": "{menu.surface-dark-item-hover-bg}", "$type": "color", "$description": "Fondo de ítem al hover — surface-dark" },
    "surface-dark-separator-color":   { "$value": "{color.text.on-dark}", "$type": "color", "$description": "Color del separador — surface-dark. El valor va directo al rol: un token surface-dark-* no puede referenciar otro surface-dark-*, porque ese no llega a declararse como custom property" }
  }
}
