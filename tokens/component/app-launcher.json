{
  "app-launcher": {
    "trigger-size":           { "$value": "2.5rem",                       "$type": "dimension", "$description": "Tamaño (cuadrado) del botón de rejilla" },
    "trigger-border-radius":  { "$value": "{border-radius.sm}",           "$type": "dimension", "$description": "Radio del trigger" },
    "trigger-color":          { "$value": "{color.text.on-light}",        "$type": "color",     "$description": "Color del icono de rejilla" },
    "trigger-hover-bg":       { "$value": "{color.grey-lightest}",        "$type": "color",     "$description": "Fondo del trigger al hover" },
    "focus-ring-color":       { "$value": "{color.primary}",              "$type": "color",     "$description": "Color del focus ring" },
    "focus-ring-width":       { "$value": "{border-width.md}",            "$type": "dimension", "$description": "Grosor del focus ring" },
    "focus-ring-offset":      { "$value": "{border-width.sm}",            "$type": "dimension", "$description": "Separación del focus ring" },

    "content-min-width":      { "$value": "20rem",                        "$type": "dimension", "$description": "Ancho mínimo del popover" },
    "content-columns":        { "$value": "3",                            "$type": "number",    "$description": "Número de columnas de la rejilla de apps" },
    "content-gap":            { "$value": "{spacing.1}",                  "$type": "dimension", "$description": "Espacio entre tiles" },
    "content-bg":             { "$value": "{floating-panel.bg}",          "$type": "color",     "$description": "Fondo del panel" },
    "content-border-width":   { "$value": "{floating-panel.border-width}", "$type": "dimension", "$description": "Borde del panel" },
    "content-border-color":   { "$value": "{floating-panel.border-color}", "$type": "color",    "$description": "Color del borde del panel" },
    "content-border-radius":  { "$value": "{floating-panel.border-radius}", "$type": "dimension", "$description": "Radio del panel" },
    "content-shadow":         { "$value": "{floating-panel.shadow}",      "$type": "shadow",    "$description": "Sombra del panel" },
    "content-z-index":        { "$value": "{floating-panel.z-index}",    "$type": "number",    "$description": "Z-index del popover" },
    "content-padding-block":  { "$value": "{spacing.3}",                  "$type": "dimension", "$description": "Padding vertical del panel" },
    "content-padding-inline": { "$value": "{spacing.3}",                  "$type": "dimension", "$description": "Padding horizontal del panel" },
    "transition-duration":    { "$value": "{floating-panel.transition-duration}", "$type": "number", "$description": "Duración de la animación de entrada/salida" },
    "transition-easing":      { "$value": "{floating-panel.transition-easing}",   "$type": "string",  "$description": "Easing de la animación" },

    "tile-padding-block":     { "$value": "{spacing.2}",                  "$type": "dimension", "$description": "Padding vertical de cada tile" },
    "tile-padding-inline":    { "$value": "{spacing.1}",                  "$type": "dimension", "$description": "Padding horizontal de cada tile" },
    "tile-gap":               { "$value": "{spacing.1}",                  "$type": "dimension", "$description": "Espacio entre icono y nombre dentro del tile" },
    "tile-border-radius":     { "$value": "{border-radius.sm}",           "$type": "dimension", "$description": "Radio de cada tile" },
    "tile-hover-bg":          { "$value": "{color.grey-lightest}",        "$type": "color",     "$description": "Fondo del tile al hover/focus" },
    "tile-active-bg":         { "$value": "{color.grey-lightest}",        "$type": "color",     "$description": "Fondo del tile de la app actual" },

    "tile-icon-size":         { "$value": "2.5rem",                       "$type": "dimension", "$description": "Tamaño del cuadrado de icono/inicial" },
    "tile-icon-border-radius":{ "$value": "{border-radius.sm}",           "$type": "dimension", "$description": "Radio del cuadrado de icono/inicial" },
    "tile-icon-font-size":    { "$value": "{font-size.3}",                "$type": "dimension", "$description": "Tamaño de la inicial cuando no hay icono" },
    "tile-icon-font-weight":  { "$value": "{font-weight.medium}",         "$type": "number",    "$description": "Peso de la inicial" },
    "tile-icon-color":        { "$value": "{color.white}",                "$type": "color",     "$description": "Color de la inicial sobre el fondo accent" },

    "tile-name-font-size":    { "$value": "{font-size.1}",                "$type": "dimension", "$description": "Tamaño de texto del nombre de app" },
    "tile-name-font-weight":  { "$value": "{font-weight.default}",        "$type": "number",    "$description": "Peso del nombre de app" },
    "tile-name-color":        { "$value": "{color.text.on-light}",        "$type": "color",     "$description": "Color del nombre de app" },
    "tile-name-active-font-weight": { "$value": "{font-weight.medium}",   "$type": "number",    "$description": "Peso del nombre — app actual" },

    "surface-dark-trigger-color":     { "$value": "{color.text.on-dark}",      "$type": "color", "$description": "Icono de rejilla — surface-dark" },
    "surface-dark-trigger-hover-bg":  { "$value": "rgba(255, 255, 255, 0.08)", "$type": "color", "$description": "Fondo del trigger al hover — surface-dark" },
    "surface-dark-focus-ring-color":  { "$value": "{color.text.on-dark}",      "$type": "color", "$description": "Focus ring — surface-dark. `focus-ring-color` (prussian) sería invisible sobre fondo oscuro." },
    "surface-dark-content-bg":            { "$value": "{floating-panel.surface-dark-bg}",           "$type": "color", "$description": "Fondo del panel — surface-dark" },
    "surface-dark-content-border-color":  { "$value": "{floating-panel.surface-dark-border-color}", "$type": "color", "$description": "Borde del panel — surface-dark" },
    "surface-dark-tile-hover-bg":     { "$value": "rgba(255, 255, 255, 0.08)", "$type": "color", "$description": "Fondo de tile al hover — surface-dark" },
    "surface-dark-tile-active-bg":    { "$value": "rgba(255, 255, 255, 0.08)", "$type": "color", "$description": "Fondo de tile de app actual — surface-dark" },
    "surface-dark-tile-name-color":   { "$value": "{color.text.on-dark}",      "$type": "color", "$description": "Nombre de app — surface-dark" }
  }
}
