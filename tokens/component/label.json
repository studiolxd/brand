    "font-weight":    { "$value": "{font-weight.emphasis}",    "$type": "number",    "$description": "Font weight" },
    "line-height":    { "$value": "{line-height.normal}",    "$type": "number",    "$description": "Line height" },
    "color":          { "$value": "{color.text.on-light}",    "$type": "color",     "$description": "Text color" },
    "letter-spacing": { "$value": "{letter-spacing.normal}", "$type": "dimension", "$description": "Letter spacing" },
    "surface-dark-color": { "$value": "{color.text.on-dark}", "$type": "color", "$description": "Color — surface-dark" }
