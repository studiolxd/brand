{
  "select": {
    "border-radius":          { "$value": "{border-radius.default}",        "$type": "dimension", "$description": "Radio del borde del trigger" },
    "border-width":           { "$value": "{border-width.default}",           "$type": "dimension", "$description": "Grosor del borde" },
    "border-style":           { "$value": "solid",                       "$type": "string",    "$description": "Estilo del borde" },
    "border-color":           { "$value": "{color.primary}",             "$type": "color",     "$description": "Color del borde" },
    "error-border-color":       { "$value": "{color.error-text-on-light}", "$type": "color", "$description": "Borde en error: el color de error (excepción a «bordes en prusia»)" },
    "surface-dark-error-border-color": { "$value": "{color.error-text-on-dark}", "$type": "color", "$description": "Borde en error — surface-dark" },
    "height":                 { "$value": "{size-component.md}",        "$type": "dimension", "$description": "Altura del control: la talla md del sistema. Las tallas cambian la altura, no el padding vertical" },
    "sm-height":              { "$value": "{size-component.sm}",        "$type": "dimension", "$description": "Altura — sm" },
    "lg-height":              { "$value": "{size-component.lg}",        "$type": "dimension", "$description": "Altura — lg" },
    "padding-inline":         { "$value": "{control.padding-inline}",    "$type": "dimension", "$description": "Padding inline del trigger" },
    "icon-gap":               { "$value": "{spacing.2}",                 "$type": "dimension", "$description": "Entre el valor y el chevron (el chevron mide su talla de icono)" },
    "font-family":            { "$value": "{font-family.sans}",          "$type": "string",    "$description": "Familia tipográfica" },
    "font-size":              { "$value": "{font-size.2}",               "$type": "dimension", "$description": "Tamaño de fuente" },
    "line-height":            { "$value": "{control.line-height}",       "$type": "number",    "$description": "Interlineado del trigger" },
    "font-weight":            { "$value": "{font-weight.default}",       "$type": "number",    "$description": "Peso tipográfico" },
    "color":                  { "$value": "{color.text.on-light}",        "$type": "color",     "$description": "Color del texto" },
    "bg":                     { "$value": "{color.white}",               "$type": "color",     "$description": "Fondo del trigger" },
    "icon-transition":        { "$value": "{motion.duration.fast}",      "$type": "number",    "$description": "Duración de la transición del icono" },
    "focus-ring-width":       { "$value": "{border-width.focus}",           "$type": "dimension", "$description": "Grosor del anillo de foco" },
    "focus-ring-color":       { "$value": "{color.primary}",             "$type": "color",     "$description": "Color del anillo de foco" },
    "content-bg":             { "$value": "{color.white}",               "$type": "color",     "$description": "Fondo del dropdown" },
    "content-border-color":   { "$value": "{color.primary}",             "$type": "color",     "$description": "Borde del dropdown" },
    "separator-color":        { "$value": "{separator.color}",           "$type": "color",     "$description": "Color del separador entre grupos — el de la línea del sistema" },
    "separator-height":       { "$value": "{separator.thickness}",       "$type": "dimension", "$description": "Grosor del separador entre grupos — el de la línea del sistema" },
    "content-z-index":        { "$value": "{z-index.floating}",                        "$type": "number",    "$description": "Capa del desplegable: flotante" },
    "content-max-height":     { "$value": "var(--available-height)", "$type": "string", "$description": "Altura máxima del dropdown (por defecto, el espacio disponible en viewport que expone Base UI)" },
    "item-padding-block":     { "$value": "{spacing.2}",                 "$type": "dimension", "$description": "Padding block de cada opción" },
    "item-selected-font-weight": { "$value": "{font-weight.emphasis}",  "$type": "number",    "$description": "La opción elegida, en énfasis" },
    "item-highlighted-bg":    { "$value": "{color.surface.secondary-on-light}", "$type": "color", "$description": "Relleno de la opción bajo el puntero o el teclado (`[data-highlighted]`). Excepción declarada a «los estados no se rellenan» (Foundations → Colores): en una lista de opciones densa el relleno es lo único que se lee de un vistazo mientras el teclado recorre la lista" },
    "sm-font-size":           { "$value": "{font-size.1}",               "$type": "dimension", "$description": "Cuerpo — sm" },
    "sm-padding-inline":      { "$value": "{spacing.2}",                 "$type": "dimension", "$description": "Padding inline del trigger — variante sm" },
    "sm-item-padding-block":  { "$value": "{spacing.1}",                 "$type": "dimension", "$description": "Padding block de cada opción — variante sm" },
    "lg-font-size":           { "$value": "{font-size.3}",               "$type": "dimension", "$description": "Cuerpo — lg" },
    "lg-padding-inline":      { "$value": "{spacing.5}",                 "$type": "dimension", "$description": "Padding inline del trigger — variante lg" },
    "lg-item-padding-block":  { "$value": "{spacing.3}",                 "$type": "dimension", "$description": "Padding block de cada opción — variante lg" },
    "surface-dark-bg":                     { "$value": "{color.background.dark}", "$type": "color", "$description": "Fondo del trigger — surface-dark" },
    "surface-dark-color":                  { "$value": "{color.text.on-dark}",    "$type": "color", "$description": "Color del texto — surface-dark" },
    "surface-dark-border-color":           { "$value": "{color.text.on-dark}",    "$type": "color", "$description": "Color del borde — surface-dark" },
    "surface-dark-focus-ring-color":       { "$value": "{color.text.on-dark}",    "$type": "color", "$description": "Color del anillo de foco — surface-dark" },
    "surface-dark-content-bg":             { "$value": "{color.background.dark}", "$type": "color", "$description": "Fondo del dropdown — surface-dark" },
    "surface-dark-content-border-color":   { "$value": "{color.text.on-dark}",    "$type": "color", "$description": "Borde del dropdown — surface-dark" },
    "surface-dark-separator-color":        { "$value": "{color.text.on-dark}",    "$type": "color", "$description": "Color del separador entre grupos — surface-dark" },
    "surface-dark-item-highlighted-bg":    { "$value": "{color.surface.secondary-on-dark}", "$type": "color", "$description": "Relleno de la opción resaltada — surface-dark" },
    "item-focus-ring-width":  { "$value": "{border-width.focus}",   "$type": "dimension", "$description": "Grosor del anillo de la opción resaltada. La opción bajo el puntero o el teclado no se rellena (regla de Colores): la marca el anillo del sistema" },
    "item-focus-ring-offset": { "$value": "calc(-1 * {border-width.focus})", "$type": "dimension", "$description": "Separación del anillo de la opción: hacia dentro, para no salirse del panel" },
    "item-focus-ring-color":  { "$value": "{color.primary}",        "$type": "color",     "$description": "Color del anillo de la opción — tinta de la superficie" },
    "surface-dark-item-focus-ring-color": { "$value": "{color.text.on-dark}", "$type": "color", "$description": "Color del anillo de la opción — surface-dark" }
  }
}
