{
  "menu-button": {
    "size-sm":            { "$value": "{size-component.sm}",   "$type": "dimension", "$description": "Lado del botón en talla sm" },
    "size-md":            { "$value": "{size-component.md}",   "$type": "dimension", "$description": "Lado del botón en talla md (por defecto)" },
    "color":              { "$value": "{color.text.on-light}", "$type": "color",     "$description": "Color del glifo" },
    "transition-duration":{ "$value": "{motion.duration.base}","$type": "number",    "$description": "Duración del paso de barras a aspa" },
    "transition-easing":  { "$value": "{motion.easing.in-out}","$type": "string",    "$description": "Curva del paso de barras a aspa: movimiento" },
    "focus-ring-width":   { "$value": "{border-width.focus}",  "$type": "dimension", "$description": "Grosor del anillo de foco" },
    "focus-ring-offset":  { "$value": "{border-width.focus}",  "$type": "dimension", "$description": "Separación del anillo de foco" },
    "focus-ring-color":   { "$value": "{color.primary}",       "$type": "color",     "$description": "Color del anillo de foco" },
    "surface-dark-color":            { "$value": "{color.text.on-dark}", "$type": "color", "$description": "Color del glifo — surface-dark" },
    "surface-dark-focus-ring-color": { "$value": "{color.text.on-dark}", "$type": "color", "$description": "Anillo de foco — surface-dark" }
  }
}
