{
  "checkbox": {
    "size":                  { "$value": "1.25em",                      "$type": "string",    "$description": "Tamaño del checkbox (ancho y alto)" },
    "check-size":            { "$value": "0.65em",                      "$type": "string",    "$description": "Tamaño del checkmark interior" },
    "border-radius":         { "$value": "{border-radius.default}",        "$type": "dimension", "$description": "Border radius" },
    "border-width":          { "$value": "{border-width.default}",           "$type": "dimension", "$description": "Border width" },
    "border-style":          { "$value": "solid",                       "$type": "string",    "$description": "Border style" },
    "border-color":          { "$value": "{color.primary}",             "$type": "color",     "$description": "Color del borde" },
    "bg":                    { "$value": "transparent",                  "$type": "string",    "$description": "Fondo sin marcar" },
    "bg-checked":            { "$value": "{color.primary}",             "$type": "color",     "$description": "Fondo cuando está marcado" },
    "check-color":           { "$value": "{color.white}",               "$type": "color",     "$description": "Color del checkmark" },
    "cursor":                { "$value": "pointer",                      "$type": "string",    "$description": "Cursor" },
    "transition-duration":   { "$value": "{motion.duration.fast}",      "$type": "number",    "$description": "Duración de transiciones" },
    "transition-easing":     { "$value": "{motion.easing.default}",     "$type": "string",    "$description": "Easing de transiciones" },
    "focus-ring-width":      { "$value": "{border-width.focus}",           "$type": "dimension", "$description": "Ancho del anillo de foco" },
    "focus-ring-offset":     { "$value": "{border-width.default}",           "$type": "dimension", "$description": "Separación del anillo de foco respecto al borde" },
    "focus-ring-color":      { "$value": "{color.primary}",             "$type": "color",     "$description": "Color del anillo de foco" },
    "error-border-color":    { "$value": "{color.error-text-on-light}",  "$type": "color",     "$description": "Borde en error: el color de error (texto/borde, nunca fondo)" },
    "surface-dark-error-border-color": { "$value": "{color.error-text-on-dark}", "$type": "color", "$description": "Borde en error — surface-dark" },
    "disabled-cursor":          { "$value": "not-allowed",              "$type": "string",    "$description": "Cursor cuando está deshabilitado" },
    "disabled-border-color":    { "$value": "{color.disabled.border-on-light}", "$type": "color",     "$description": "Color del borde cuando está deshabilitado" },
    "disabled-bg-checked":      { "$value": "{color.disabled.border-on-light}", "$type": "color",     "$description": "Fondo marcado/indeterminado cuando está deshabilitado" },
    "check-rotate":           { "$value": "15deg",                        "$type": "string",    "$description": "Rotación del checkmark en animación de entrada/salida" },
    "sm-size":                { "$value": "1rem",                         "$type": "dimension", "$description": "Tamaño del checkbox — variante sm (16px)" },
    "sm-check-size":          { "$value": "0.55rem",                      "$type": "dimension", "$description": "Tamaño del checkmark interior — variante sm" },
    "lg-size":                { "$value": "1.5rem",                       "$type": "dimension", "$description": "Tamaño del checkbox — variante lg (24px)" },
    "lg-check-size":          { "$value": "0.85rem",                      "$type": "dimension", "$description": "Tamaño del checkmark interior — variante lg" },
    "surface-dark-border-color":     { "$value": "{color.text.on-dark}",       "$type": "color", "$description": "Border color — surface-dark" },
    "surface-dark-bg-checked":       { "$value": "{color.text.on-dark}",       "$type": "color", "$description": "Background when checked — surface-dark" },
    "surface-dark-check-color":      { "$value": "{color.background.dark}",    "$type": "color", "$description": "Checkmark color — surface-dark" },
    "surface-dark-focus-ring-color": { "$value": "{color.text.on-dark}",       "$type": "color", "$description": "Focus ring color — surface-dark" },
    "surface-dark-disabled-border-color": { "$value": "{color.text.muted-on-dark}", "$type": "color", "$description": "Borde deshabilitado — surface-dark" },
    "surface-dark-disabled-bg-checked": { "$value": "{color.text.muted-on-dark}", "$type": "color", "$description": "Fondo marcado deshabilitado — surface-dark" }
  }
}
