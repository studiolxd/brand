{
  "empty-state": {
    "gap":                     { "$value": "{spacing.4}",               "$type": "dimension", "$description": "Gap entre icono, cuerpo y acción" },
    "body-gap":                { "$value": "{spacing.2}",               "$type": "dimension", "$description": "Gap entre título y descripción" },
    "padding-block":           { "$value": "{spacing.7}",               "$type": "dimension", "$description": "Padding vertical del contenedor" },
    "padding-inline":          { "$value": "{spacing.5}",               "$type": "dimension", "$description": "Padding horizontal del contenedor" },
    "icon-size":               { "$value": "{icon.size-lg}",            "$type": "dimension", "$description": "Tamaño del icono — variante md (unificado con el icono destacado del sistema)" },
    "icon-size-sm":            { "$value": "2rem",                      "$type": "dimension", "$description": "Tamaño del icono — variante sm" },
    "title-font-size-sm":      { "$value": "{font-size.3}",             "$type": "dimension", "$description": "Tamaño tipográfico del título — variante sm" },
    "description-font-size-sm":{ "$value": "{font-size.1}",             "$type": "dimension", "$description": "Tamaño tipográfico de la descripción — variante sm" },
    "icon-color":              { "$value": "{color.grey-dark}",         "$type": "color",     "$description": "Color del icono" },
    "title-font-family":       { "$value": "{font-family.sans}",        "$type": "string",    "$description": "Familia tipográfica del título" },
    "title-font-size":         { "$value": "{font-size.4}",             "$type": "dimension", "$description": "Tamaño tipográfico del título" },
    "title-font-weight":       { "$value": "{font-weight.emphasis}",      "$type": "number",    "$description": "Peso del título" },
    "title-color":             { "$value": "{color.text.muted-on-light}", "$type": "color",   "$description": "Color del título — es texto, nunca grey-dark" },
    "description-font-family": { "$value": "{font-family.sans}",        "$type": "string",    "$description": "Familia tipográfica de la descripción" },
    "description-font-size":   { "$value": "{text.font-size}",          "$type": "dimension", "$description": "La descripción hereda el cuerpo de la superficie (la variante sm tiene talla propia)" },
    "description-color":       { "$value": "{color.text.muted-on-light}", "$type": "color",   "$description": "Color de la descripción — es texto, nunca grey-dark" },
    "surface-dark-title-color":       { "$value": "{color.text.muted-on-dark}", "$type": "color", "$description": "Título — superficie oscura" },
    "surface-dark-description-color": { "$value": "{color.text.muted-on-dark}", "$type": "color", "$description": "Descripción — superficie oscura" },
    "surface-dark-icon-color":                   { "$value": "{color.text.muted-on-dark}", "$type": "color", "$description": "Icono — surface-dark: `grey-dark` no llega a 3:1 sobre prusia" }
  }
}
