{
  "menu": {
    "bg":                  { "$value": "{floating-panel.bg}",                  "$type": "color",     "$description": "Fondo del panel — mismo lenguaje que ContextMenu" },
    "border-width":        { "$value": "{floating-panel.border-width}",        "$type": "dimension", "$description": "Grosor del borde del panel" },
    "border-color":        { "$value": "{floating-panel.border-color}",        "$type": "color",     "$description": "Color del borde del panel" },
    "border-radius":       { "$value": "{floating-panel.border-radius}",       "$type": "dimension", "$description": "Radio del panel" },
    "shadow":              { "$value": "{floating-panel.shadow}",              "$type": "shadow",    "$description": "Sombra del panel" },
    "z-index":             { "$value": "{floating-panel.z-index}",           "$type": "number",    "$description": "Capa z del panel flotante" },
    "padding-block":       { "$value": "{spacing.2}",       "$type": "dimension", "$description": "Padding vertical del panel" },
    "padding-inline":      { "$value": "{spacing.2}",      "$type": "dimension", "$description": "Padding lateral del panel" },
    "item-padding-block":  { "$value": "{spacing.2}",  "$type": "dimension", "$description": "Padding vertical de cada ítem" },
    "item-padding-inline": { "$value": "{spacing.4}", "$type": "dimension", "$description": "Padding horizontal de cada ítem" },
    "item-icon-gap":       { "$value": "{spacing.2}",       "$type": "dimension", "$description": "Gap entre icono y texto del ítem" },
    "item-icon-size":      { "$value": "{font-size.4}",                      "$type": "dimension", "$description": "Talla del icono y del glifo de radio" },
    "item-border-radius":  { "$value": "{border-radius.default}",  "$type": "dimension", "$description": "Radio de cada ítem" },
    "item-font-family":    { "$value": "{font-family.sans}",    "$type": "string",    "$description": "Tipografía de ítems" },
    "item-font-size":      { "$value": "{font-size.2}",      "$type": "dimension", "$description": "Tamaño de texto de ítems" },
    "item-font-weight":    { "$value": "{font-weight.default}",    "$type": "number",    "$description": "Peso de texto de ítems" },
    "item-line-height":    { "$value": "{line-height.snug}",    "$type": "number",    "$description": "Interlineado de ítems" },
    "item-color":          { "$value": "{color.text.on-light}",          "$type": "color",     "$description": "Color de texto de ítems" },
    "item-hover-bg":       { "$value": "{color.primary}",       "$type": "color",     "$description": "Fondo de ítem al hover" },
    "item-hover-color":    { "$value": "{color.text.on-dark}",    "$type": "color",     "$description": "Color de texto de ítem al hover" },
    "item-selected-font-weight": { "$value": "{font-weight.emphasis}", "$type": "number", "$description": "La opción elegida de un grupo de radio, en énfasis: sin glifo" },
    "item-cursor":         { "$value": "pointer",         "$type": "string",    "$description": "Cursor de ítems" },
    "item-destructive-color":       { "$value": "{color.destructive-text-on-light}",       "$type": "color", "$description": "Color de texto de ítem destructivo" },
    "item-destructive-hover-bg":    { "$value": "{color.destructive-fill}",    "$type": "color", "$description": "Fondo de ítem destructivo al hover" },
    "item-destructive-hover-color": { "$value": "{color.destructive-fill-text}", "$type": "color", "$description": "Color de texto de ítem destructivo al hover" },
    "label-padding-block":  { "$value": "{spacing.2}",                       "$type": "dimension", "$description": "Padding vertical del rótulo de sección" },
    "label-padding-inline": { "$value": "{spacing.4}",                       "$type": "dimension", "$description": "Padding horizontal del rótulo de sección" },
    "label-font-size":      { "$value": "{font-size.1}",                     "$type": "dimension", "$description": "Tamaño de texto del rótulo de sección" },
    "label-font-weight":    { "$value": "{font-weight.emphasis}",              "$type": "number",    "$description": "Peso del rótulo de sección" },
    "label-color":          { "$value": "{color.text.muted-on-light}",       "$type": "color",     "$description": "Color del rótulo de sección" },
    "separator-color":     { "$value": "{color.grey-light}",     "$type": "color",     "$description": "Color del separador" },
    "separator-height":    { "$value": "{border-width.default}",    "$type": "dimension", "$description": "Alto del separador" },
    "separator-margin-block": { "$value": "{spacing.2}", "$type": "dimension", "$description": "Margen vertical del separador" },
    "disabled-opacity":    { "$value": "{opacity.disabled}",    "$type": "number",    "$description": "Opacidad de ítems deshabilitados" },
    "transition-duration": { "$value": "{floating-panel.transition-duration}", "$type": "number",    "$description": "Duración de transición" },
    "transition-easing":   { "$value": "{floating-panel.transition-easing}",   "$type": "string",    "$description": "Easing de transición" },
    "surface-dark-item-color":                  { "$value": "{color.text.on-dark}",                  "$type": "color", "$description": "Color de texto de ítems — surface-dark" },
    "surface-dark-item-hover-bg":               { "$value": "{color.text.on-dark}",               "$type": "color", "$description": "Fondo hover de ítem — surface-dark" },
    "surface-dark-item-hover-color":            { "$value": "{color.primary}",            "$type": "color", "$description": "Texto hover de ítem — surface-dark" },
    "surface-dark-separator-color":             { "$value": "rgba(255, 255, 255, 0.15)",             "$type": "color", "$description": "Color del separador — surface-dark" },
    "surface-dark-label-color":                 { "$value": "{color.text.muted-on-dark}",                              "$type": "color", "$description": "Color del rótulo de sección — surface-dark" },
    "surface-dark-item-destructive-color":       { "$value": "{color.destructive-text-on-dark}",      "$type": "color", "$description": "Color de ítem destructivo — surface-dark" },
    "surface-dark-item-destructive-hover-bg":    { "$value": "{color.destructive-fill}",   "$type": "color", "$description": "Fondo hover de ítem destructivo — surface-dark" },
    "surface-dark-item-destructive-hover-color": { "$value": "{color.destructive-fill-text}","$type": "color", "$description": "Texto hover de ítem destructivo — surface-dark" }
  }
}
