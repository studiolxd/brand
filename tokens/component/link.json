{
  "link": {
    "color":                 { "$value": "{color.text.on-light}",   "$type": "color",     "$description": "El enlace no tiene color propio: es texto, y lo distingue el subrayado" },
    "hover-color":           { "$value": "{color.text.on-light}",   "$type": "color",     "$description": "Color en hover" },
    "text-decoration":       { "$value": "underline",               "$type": "string",    "$description": "En reposo, subrayado: es lo que dice «esto se pulsa» sin depender del color" },
    "hover-text-decoration": { "$value": "none",                    "$type": "string",    "$description": "En hover el subrayado desaparece" },
    "cursor":                { "$value": "pointer",                 "$type": "string",    "$description": "Cursor" },
    "focus-ring-width":      { "$value": "{border-width.focus}",    "$type": "dimension", "$description": "Grosor del anillo de foco" },
    "focus-ring-offset":     { "$value": "{border-width.default}",  "$type": "dimension", "$description": "Separación entre el enlace y el anillo" },
    "focus-ring-color":      { "$value": "{color.primary}",         "$type": "color",     "$description": "Anillo de foco" },
    "surface-dark-color":            { "$value": "{color.text.on-dark}", "$type": "color", "$description": "Color — surface-dark" },
    "surface-dark-hover-color":      { "$value": "{color.text.on-dark}", "$type": "color", "$description": "Hover — surface-dark" },
    "surface-dark-focus-ring-color": { "$value": "{color.text.on-dark}", "$type": "color", "$description": "Anillo de foco — surface-dark" }
  }
}
