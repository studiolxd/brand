{
  "skip-link": {
    "bg":                { "$value": "{color.primary}",         "$type": "color",     "$description": "Fondo del enlace revelado: relleno de marca" },
    "color":             { "$value": "{color.text.on-dark}",    "$type": "color",     "$description": "Texto sobre el relleno" },
    "padding-block":     { "$value": "{spacing.2}",             "$type": "dimension", "$description": "Aire vertical del enlace revelado" },
    "padding-inline":    { "$value": "{spacing.4}",             "$type": "dimension", "$description": "Aire horizontal del enlace revelado" },
    "inset":             { "$value": "{spacing.2}",             "$type": "dimension", "$description": "Separación de la esquina de la ventana al revelarse" },
    "font-weight":       { "$value": "{font-weight.emphasis}",  "$type": "number",    "$description": "Peso del texto: es una acción" },
    "focus-ring-width":  { "$value": "{border-width.focus}",    "$type": "dimension", "$description": "Grosor del anillo de foco" },
    "focus-ring-offset": { "$value": "{border-width.focus}",    "$type": "dimension", "$description": "Separación del anillo de foco" },
    "focus-ring-color":  { "$value": "{color.text.on-dark}",    "$type": "color",     "$description": "Anillo de foco: contrasta con el relleno" },
    "z-index":           { "$value": "{z-index.skip}",          "$type": "number",    "$description": "Sobre cualquier otra capa: es lo primero al tabular" },

    "surface-dark-bg":               { "$value": "{color.text.on-dark}",  "$type": "color", "$description": "Fondo — surface-dark: el relleno se invierte para verse sobre prusia" },
    "surface-dark-color":            { "$value": "{color.primary}",       "$type": "color", "$description": "Texto — surface-dark" },
    "surface-dark-focus-ring-color": { "$value": "{color.primary}",       "$type": "color", "$description": "Anillo de foco — surface-dark" }
  }
}
