{
  "number-badge": {
    "min-size":       { "$value": "1rem",                 "$type": "dimension", "$description": "16px: una marca, no un control (fuera de la escala de tallas); cabe un dígito redondo, dos en píldora" },
    "padding-inline": { "$value": "{spacing.1}",           "$type": "dimension", "$description": "Padding horizontal para números de más de un dígito" },
    "border-radius":  { "$value": "{border-radius.round}",  "$type": "dimension", "$description": "Forma circular" },
    "font-family":    { "$value": "{font-family.sans}",    "$type": "string",    "$description": "Familia tipográfica" },
    "font-size":      { "$value": "{font-size.0}",         "$type": "dimension", "$description": "La cifra: el cuerpo de marca (12px)" },
    "font-weight":    { "$value": "{font-weight.default}",  "$type": "number",    "$description": "Peso normal: una cifra, no un título" },
    "line-height":    { "$value": "{line-height.none}",    "$type": "number",    "$description": "Sin interlineado extra — centrado por flexbox" },

    "primary-bg":     { "$value": "{color.primary}",          "$type": "color", "$description": "Fondo primary (prussian)" },
    "primary-color":  { "$value": "{color.text.on-dark}",     "$type": "color", "$description": "Texto sobre primary" },
    "accent-1-bg":    { "$value": "{color.accent-1}",         "$type": "color", "$description": "Fondo accent-1 (lavender)" },
    "accent-1-color": { "$value": "{color.text.on-light}",    "$type": "color", "$description": "Texto sobre accent-1" },
    "accent-2-bg":    { "$value": "{color.accent-2}",         "$type": "color", "$description": "Fondo accent-2 (yellow)" },
    "accent-2-color": { "$value": "{color.text.on-light}",    "$type": "color", "$description": "Texto sobre accent-2" },
    "support-1-bg":   { "$value": "{color.support-1}",        "$type": "color", "$description": "Fondo support-1 (emerald)" },
    "support-1-color":{ "$value": "{color.text.on-light}",    "$type": "color", "$description": "Texto sobre support-1" },
    "support-2-bg":   { "$value": "{color.support-2}",        "$type": "color", "$description": "Fondo support-2 (cayenne)" },
    "support-2-color":{ "$value": "{color.text.on-light}",    "$type": "color", "$description": "Texto sobre support-2" },
    "danger-bg":      { "$value": "{color.error-fill}",     "$type": "color", "$description": "Fondo danger (red)" },
    "danger-color":   { "$value": "{color.error-fill-text}",            "$type": "color", "$description": "Texto sobre danger" },
    "success-bg":     { "$value": "{color.success-fill}", "$type": "color", "$description": "Fondo success (green)" },
    "success-color":  { "$value": "{color.success-fill-text}",            "$type": "color", "$description": "Texto sobre success" },
    "neutral-bg":     { "$value": "{color.surface.inverse-on-light}", "$type": "color", "$description": "Fondo neutral (dark grey)" },
    "neutral-color":  { "$value": "{color.text.on-dark}",            "$type": "color", "$description": "Texto sobre neutral" },
    "surface-dark-primary-bg":                   { "$value": "{color.text.on-dark}", "$type": "color", "$description": "Relleno primary — surface-dark. El prusia es el lienzo y el contador desaparecería; se invierte en vez de pasar a lavanda porque `accent-1` ya es otra variante del mismo componente (mismo caso que `Tag`)" },
    "surface-dark-primary-color":                { "$value": "{color.background.dark}", "$type": "color", "$description": "Texto sobre primary — surface-dark" },
    "surface-dark-neutral-bg":                   { "$value": "{color.surface.inverse-on-dark}", "$type": "color", "$description": "Relleno neutral — surface-dark: la superficie invertida, como en `Tag`" },
    "surface-dark-neutral-color":                { "$value": "{color.text.on-light}", "$type": "color", "$description": "Texto sobre neutral — surface-dark" }
  }
}
