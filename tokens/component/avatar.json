{
  "avatar": {
    "size": {
      "sm": { "$value": "{size-component.sm}", "$type": "dimension", "$description": "32px — en barras y menús (UserMenu, OrgSwitcher)" },
      "md": { "$value": "{size-component.md}", "$type": "dimension", "$description": "40px — por defecto: listas, tarjetas" },
      "lg": { "$value": "{size-component.lg}", "$type": "dimension", "$description": "48px — cabeceras de perfil" }
    },
    "border-radius":        { "$value": "{border-radius.round}",   "$type": "dimension", "$description": "Personas: círculo" },
    "border-radius-square": { "$value": "{border-radius.default}", "$type": "dimension", "$description": "Organizaciones (logos): el radio del sistema" },
    "initials-bg":          { "$value": "{color.primary}",         "$type": "color",     "$description": "Fondo de las iniciales" },
    "initials-color":       { "$value": "{color.text.on-dark}",    "$type": "color",     "$description": "Iniciales sobre el fondo" },
    "initials-font-weight": { "$value": "{font-weight.emphasis}",  "$type": "number",    "$description": "Iniciales: énfasis" },
    "initials-font-size-sm": { "$value": "{font-size.1}",          "$type": "dimension", "$description": "Iniciales a talla sm" },
    "initials-font-size-md": { "$value": "{font-size.2}",          "$type": "dimension", "$description": "Iniciales a talla md" },
    "initials-font-size-lg": { "$value": "{font-size.3}",          "$type": "dimension", "$description": "Iniciales a talla lg" },
    "surface-dark-initials-bg":    { "$value": "{color.text.on-dark}", "$type": "color", "$description": "Iniciales — surface-dark: se invierten" },
    "surface-dark-initials-color": { "$value": "{color.primary}",      "$type": "color", "$description": "Iniciales — surface-dark" }
  }
}
