{
  "control": {
    "border-style":          { "$value": "solid",                          "$type": "string",    "$description": "Estilo del borde" },
    "border-radius":         { "$value": "{border-radius.default}",           "$type": "dimension", "$description": "Radio del borde" },
    "border-width":          { "$value": "{border-width.default}",              "$type": "dimension", "$description": "Grosor del borde" },
    "height":                { "$value": "{size-component.md}",            "$type": "dimension", "$description": "Altura del control de una línea: la talla md del sistema. Es la talla de PARTIDA, y la superficie pública la apunta a `lg-height`" },
    "font-family":           { "$value": "{font-family.sans}",             "$type": "string",    "$description": "Familia tipográfica" },
    "font-size":             { "$value": "{font-size.2}",                  "$type": "dimension", "$description": "Tamaño de fuente" },
    "font-weight":           { "$value": "{font-weight.default}",          "$type": "number",    "$description": "Peso tipográfico" },
    "line-height":           { "$value": "{line-height.none}",             "$type": "number",    "$description": "Interlineado" },
    "cursor":                { "$value": "text",                           "$type": "string",    "$description": "Cursor por defecto" },
    "disabled-cursor":       { "$value": "not-allowed",                    "$type": "string",    "$description": "Cursor cuando está deshabilitado" },
    "transition-duration":   { "$value": "{motion.duration.fast}",         "$type": "number",    "$description": "Duración de la transición" },
    "transition-easing":     { "$value": "{motion.easing.default}",        "$type": "string",    "$description": "Curva de animación" },
    "focus-ring-width":      { "$value": "{border-width.focus}",              "$type": "dimension", "$description": "Grosor del anillo de foco" },
    "focus-ring-inset-offset": { "$value": "{border-width.default}",            "$type": "dimension", "$description": "Separación entre borde y anillo de foco" },
    "padding-inline":        { "$value": "{spacing.4}",                    "$type": "dimension", "$description": "Padding inline — compartido por controles y elementos de formulario" },
    "padding-block":         { "$value": "{spacing.4}",                    "$type": "dimension", "$description": "Padding block — solo para lo multilínea (Textarea) y para el aire de las filas de formulario. Los controles de una línea fijan su altura a la talla (`height`) con padding vertical 0" },

    "lg-height":             { "$value": "{size-component.lg}",            "$type": "dimension", "$description": "Altura del control en talla lg: la talla lg del sistema. Es lo que la superficie pública pone como talla de partida (`.site-shell`)" },
    "lg-font-size":          { "$value": "{font-size.3}",                  "$type": "dimension", "$description": "Tamaño de fuente en talla lg (20px), el cuerpo de la superficie pública" },
    "lg-padding-inline":     { "$value": "{spacing.5}",                    "$type": "dimension", "$description": "Padding inline en talla lg" }
  }
}
