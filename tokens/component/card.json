{
  "card": {
    "padding-inline":           { "$value": "{spacing.4}", "$type": "dimension", "$description": "Padding horizontal" },
    "padding-block-start":      { "$value": "{spacing.4}", "$type": "dimension", "$description": "Padding block start" },
    "padding-block-end":        { "$value": "{spacing.3}", "$type": "dimension", "$description": "Padding block end" },
    "gap":                      { "$value": "{spacing.3}", "$type": "dimension", "$description": "Separación entre elementos internos" },
    "border-radius":            { "$value": "{border-radius.default}", "$type": "dimension", "$description": "Radio de esquinas — sin redondeado" },
    "description-font-size":    { "$value": "{font-size.3}", "$type": "dimension", "$description": "Tamaño de fuente de la descripción" },
    "description-margin-block-end": { "$value": "{spacing.7}", "$type": "dimension", "$description": "Margen inferior de la descripción" },
    "header-gap":               { "$value": "{spacing.3}", "$type": "dimension", "$description": "Separación entre título y acción en la cabecera" },
    "title-font-weight":        { "$value": "{font-weight.emphasis}", "$type": "number", "$description": "Peso del título de la tarjeta" },
    "footer-gap":               { "$value": "{spacing.2}", "$type": "dimension", "$description": "Separación entre acciones del pie" },

    "primary-bg":    { "$value": "{color.accent-1}",        "$type": "color", "$description": "Variante primary — fondo lavanda. No es `color.primary` (prussian): coincidiría con `color.background.dark` y desaparecería sobre `.surface-dark`. Mismo patrón autocontenido que `button.primary` — un par que no depende de la superficie ambiente, igual en claro y oscuro" },
    "primary-color": { "$value": "{color.primary}",         "$type": "color", "$description": "Variante primary — texto prussian sobre el fondo lavanda" },

    "accent-1-bg":    { "$value": "{color.accent-1}",            "$type": "color", "$description": "Variante accent-1 — fondo lavanda" },
    "accent-1-color": { "$value": "{color.text.on-light}",       "$type": "color", "$description": "Variante accent-1 — texto. Color saturado que ya contrasta en cualquier superficie: sin par surface-dark, como las variantes semánticas de Alert/Tag" },
    "accent-2-bg":    { "$value": "{color.accent-2}",            "$type": "color", "$description": "Variante accent-2 — fondo amarillo" },
    "accent-2-color": { "$value": "{color.text.on-light}",       "$type": "color", "$description": "Variante accent-2 — texto. Sin par surface-dark: mismo motivo que accent-1" },
    "support-1-bg":    { "$value": "{color.support-1}",          "$type": "color", "$description": "Variante support-1 — fondo esmeralda" },
    "support-1-color": { "$value": "{color.text.on-light}",      "$type": "color", "$description": "Variante support-1 — texto. Sin par surface-dark: mismo motivo que accent-1" },
    "support-2-bg":    { "$value": "{color.support-2}",          "$type": "color", "$description": "Variante support-2 — fondo cayena" },
    "support-2-color": { "$value": "{color.text.on-light}",      "$type": "color", "$description": "Variante support-2 — texto. Sin par surface-dark: mismo motivo que accent-1" },

    "outline-bg":           { "$value": "{color.background.light}", "$type": "color",     "$description": "Variante outline — fondo blanco (light)" },
    "outline-color":        { "$value": "{color.text.on-light}",    "$type": "color",     "$description": "Variante outline — texto oscuro sobre blanco" },
    "outline-border-color": { "$value": "{color.primary}",          "$type": "color",     "$description": "Variante outline — borde prussian" },
    "outline-border-width": { "$value": "{border-width.default}",        "$type": "dimension", "$description": "Variante outline — grosor de borde" },
    "surface-dark-outline-bg":           { "$value": "{color.background.dark}", "$type": "color", "$description": "Variante outline — fondo, surface-dark" },
    "surface-dark-outline-color":        { "$value": "{color.text.on-dark}",    "$type": "color", "$description": "Variante outline — texto, surface-dark" },
    "surface-dark-outline-border-color": { "$value": "{color.text.on-dark}",    "$type": "color", "$description": "Variante outline — borde, surface-dark" }
  }
}
