{
  "textarea": {
    "border-radius":                    { "$value": "{border-radius.default}",      "$type": "dimension", "$description": "Border radius" },
    "border-width":                     { "$value": "{border-width.default}",         "$type": "dimension", "$description": "Border width" },
    "border-style":                     { "$value": "solid",                     "$type": "string",    "$description": "Border style" },
    "width":                            { "$value": "100%",                      "$type": "string",    "$description": "Textarea is always full width" },
    "padding-block":                    { "$value": "{control.padding-block}",   "$type": "dimension", "$description": "Block (vertical) padding" },
    "padding-inline":                   { "$value": "{control.padding-inline}",  "$type": "dimension", "$description": "Inline (horizontal) padding" },
    "font-family":                      { "$value": "{font-family.sans}",        "$type": "string",    "$description": "Font family" },
    "font-size":                        { "$value": "{font-size.2}",             "$type": "dimension", "$description": "Font size" },
    "font-weight":                      { "$value": "{font-weight.default}",     "$type": "number",    "$description": "Font weight" },
    "line-height":                      { "$value": "{line-height.normal}",      "$type": "number",    "$description": "Line height" },
    "rows":                             { "$value": "4",                         "$type": "number",    "$description": "Líneas de texto que mide el campo por defecto. Cuatro: dos no se distinguen de un campo de una línea y cinco ya ocupa media pantalla en móvil. De aquí sale `min-height`" },
    "min-height":                       { "$value": "calc({textarea.rows} * {textarea.line-height} * {textarea.font-size} + 2 * {textarea.padding-block} + 2 * {textarea.border-width})", "$type": "dimension", "$description": "Altura mínima: `rows` líneas de texto (rows × interlineado × cuerpo) más el aire de arriba y abajo y los dos bordes. Con la talla md, 130px" },
    "resize":                           { "$value": "vertical",                  "$type": "string",    "$description": "Resize direction" },
    "cursor":                           { "$value": "text",                      "$type": "string",    "$description": "Cursor" },
    "transition-duration":              { "$value": "{motion.duration.fast}",    "$type": "number",    "$description": "Transition duration" },
    "transition-easing":                { "$value": "{motion.easing.default}",   "$type": "string",    "$description": "Transition easing" },
    "bg":                               { "$value": "{color.white}",             "$type": "color",     "$description": "Background" },
    "color":                            { "$value": "{color.text.on-light}",      "$type": "color",     "$description": "Text color" },
    "border-color":                     { "$value": "{color.primary}",           "$type": "color",     "$description": "Border color" },
    "placeholder-color":                { "$value": "{color.text.placeholder-on-light}",  "$type": "color",     "$description": "Placeholder text color" },
    "focus-border-color":               { "$value": "{color.primary}",           "$type": "color",     "$description": "Border color on focus" },
    "focus-ring-width":                 { "$value": "{control.focus-ring-width}", "$type": "dimension", "$description": "Focus ring width" },
    "focus-ring-inset-offset":          { "$value": "{border-width.default}",         "$type": "dimension", "$description": "Gap between border and focus ring" },
    "focus-ring-color":                 { "$value": "{color.primary}",           "$type": "color",     "$description": "Focus ring color" },
    "disabled-cursor":                  { "$value": "not-allowed",               "$type": "string",    "$description": "Cursor when disabled" },
    "disabled-bg":                      { "$value": "{color.grey-lightest}",     "$type": "color",     "$description": "Background when disabled" },
    "disabled-color":                   { "$value": "{color.grey-darkest}",      "$type": "color",     "$description": "Text color when disabled" },
    "disabled-border-color":            { "$value": "{color.grey-light}",        "$type": "color",     "$description": "Border color when disabled" },
    "error-bg":                         { "$value": "{color.white}",             "$type": "color",     "$description": "Error background" },
    "error-color":                      { "$value": "{color.text.on-light}",      "$type": "color",     "$description": "Error text color" },
    "error-border-color":               { "$value": "{color.primary}",           "$type": "color",     "$description": "Error border color" },
    "error-placeholder-color":          { "$value": "{color.text.placeholder-on-light}",  "$type": "color",     "$description": "Error placeholder color" },
    "error-focus-border-color":         { "$value": "{color.primary}",           "$type": "color",     "$description": "Error border color on focus" },
    "error-focus-ring-color":           { "$value": "{color.error-text-on-light}",    "$type": "color",     "$description": "Error focus ring color" },
    "sm-padding-block":                 { "$value": "{spacing.2}",               "$type": "dimension", "$description": "Block padding — variante sm" },
    "sm-padding-inline":                { "$value": "{spacing.3}",               "$type": "dimension", "$description": "Inline padding — variante sm" },
    "sm-font-size":                     { "$value": "{font-size.1}",             "$type": "dimension", "$description": "Font size — variante sm (14px)" },
    "sm-min-height":                    { "$value": "calc({textarea.rows} * {textarea.line-height} * {textarea.sm-font-size} + 2 * {textarea.sm-padding-block} + 2 * {textarea.border-width})", "$type": "dimension", "$description": "Altura mínima — sm: la misma fórmula con el cuerpo y el aire de la talla (102px)" },
    "lg-padding-block":                 { "$value": "{spacing.5}",               "$type": "dimension", "$description": "Block padding — variante lg" },
    "lg-padding-inline":                { "$value": "{spacing.5}",               "$type": "dimension", "$description": "Inline padding — variante lg" },
    "lg-font-size":                     { "$value": "{font-size.3}",             "$type": "dimension", "$description": "Font size — variante lg (20px)" },
    "lg-min-height":                    { "$value": "calc({textarea.rows} * {textarea.line-height} * {textarea.lg-font-size} + 2 * {textarea.lg-padding-block} + 2 * {textarea.border-width})", "$type": "dimension", "$description": "Altura mínima — lg: la misma fórmula con el cuerpo y el aire de la talla (170px)" },
    "surface-dark-bg":                     { "$value": "{color.background.dark}",     "$type": "color", "$description": "Background — surface-dark" },
    "surface-dark-color":                  { "$value": "{color.text.on-dark}",        "$type": "color", "$description": "Text color — surface-dark" },
    "surface-dark-border-color":           { "$value": "{color.text.on-dark}",        "$type": "color", "$description": "Border color — surface-dark" },
    "surface-dark-placeholder-color":      { "$value": "{color.text.placeholder-on-dark}",  "$type": "color", "$description": "Placeholder text color — surface-dark" },
    "surface-dark-focus-border-color":     { "$value": "{color.text.on-dark}",        "$type": "color", "$description": "Border color on focus — surface-dark" },
    "surface-dark-focus-ring-color":       { "$value": "{color.text.on-dark}",        "$type": "color", "$description": "Focus ring color — surface-dark" },
    "surface-dark-error-focus-ring-color": { "$value": "{color.error-text-on-dark}",       "$type": "color", "$description": "Error focus ring color — surface-dark" }
  }
}
