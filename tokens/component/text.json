{
  "text": {
    "font-family":     { "$value": "{font-family.sans}",          "$type": "string",    "$description": "Default font family" },
    "font-size":       { "$value": "{font-size.2}",               "$type": "dimension", "$description": "Cuerpo base (16px). Es el cuerpo de la superficie de aplicación; el SiteShell lo remapea a 20px" },
    "font-weight":     { "$value": "{font-weight.default}",       "$type": "number",    "$description": "Default font weight" },
    "line-height":     { "$value": "{line-height.normal}",        "$type": "number",    "$description": "Default line height" },
    "color":           { "$value": "{color.text.on-light}",        "$type": "color",     "$description": "Default text color" },
    "background":      { "$value": "{color.background.light}", "$type": "color",  "$description": "Fondo del lienzo de página (body)" },
    "surface-dark-color":      { "$value": "{color.text.on-dark}",     "$type": "color",  "$description": "Color de texto por defecto — surface-dark" },
    "surface-dark-background": { "$value": "{color.background.dark}",  "$type": "color",  "$description": "Fondo del lienzo de página — surface-dark" },
    "letter-spacing":  { "$value": "{letter-spacing.normal}",     "$type": "dimension", "$description": "Default letter spacing" },

    "size": {
      "1":  { "$value": "{font-size.1}",  "$type": "dimension", "$description": "Paso 1 de la escala de títulos (14px)" },
      "2":  { "$value": "{font-size.2}",  "$type": "dimension", "$description": "Paso 2 de la escala de títulos (16px)" },
      "3":  { "$value": "{font-size.2}",  "$type": "dimension", "$description": "Paso 3 de la escala de títulos (16px) — el de H6" },
      "4":  { "$value": "{font-size.3}",  "$type": "dimension", "$description": "Paso 4 de la escala de títulos (20px) — el de H5" },
      "5":  { "$value": "{font-size.4}",  "$type": "dimension", "$description": "Paso 5 de la escala de títulos (24px) — el de H4" },
      "6":  { "$value": "{font-size.5}",  "$type": "dimension", "$description": "Paso 6 de la escala de títulos (28px) — el de H3" },
      "7":  { "$value": "{font-size.6}",  "$type": "dimension", "$description": "Paso 7 de la escala de títulos (32px) — el de H2" },
      "8":  { "$value": "{font-size.7}",  "$type": "dimension", "$description": "Paso 8 de la escala de títulos (40px) — el de H1" },
      "9":  { "$value": "{font-size.8}",  "$type": "dimension", "$description": "Paso 9 de la escala de títulos (56px) — display pequeño" },
      "10": { "$value": "{font-size.10}", "$type": "dimension", "$description": "Paso 10 de la escala de títulos (96px) — display" }
    },

    "heading": {
      "font-family":    { "$value": "{font-family.sans}",         "$type": "string",    "$description": "Heading font family" },
      "font-weight":    { "$value": "{font-weight.emphasis}",       "$type": "number",    "$description": "Heading font weight" },
      "color":          { "$value": "{color.text.on-light}",       "$type": "color",     "$description": "Heading color" },
      "letter-spacing": { "$value": "{letter-spacing.tight}",     "$type": "dimension", "$description": "Heading letter spacing" }
    },

    "h1": {
      "font-family":    { "$value": "{text.heading.font-family}",    "$type": "string",    "$description": "H1 font family" },
      "font-size":      { "$value": "{text.size.8}",                 "$type": "dimension", "$description": "H1 font size — paso 8 de la escala (40px en base, un peldaño más en la superficie pública)" },
      "font-weight":    { "$value": "{text.heading.font-weight}",    "$type": "number",    "$description": "H1 font weight" },
      "line-height":    { "$value": "{line-height.tight}",           "$type": "number",    "$description": "H1 line height" },
      "color":          { "$value": "{text.heading.color}",          "$type": "color",     "$description": "H1 color" },
      "letter-spacing": { "$value": "{text.heading.letter-spacing}", "$type": "dimension", "$description": "H1 letter spacing" },
      "surface-dark-color": { "$value": "{color.text.on-dark}", "$type": "color", "$description": "H1 color — surface-dark" }
    },

    "h2": {
      "font-family":    { "$value": "{text.heading.font-family}",    "$type": "string",    "$description": "H2 font family" },
      "font-size":      { "$value": "{text.size.7}",                 "$type": "dimension", "$description": "H2 font size — paso 7 de la escala (32px en base, un peldaño más en la superficie pública)" },
      "font-weight":    { "$value": "{text.heading.font-weight}",    "$type": "number",    "$description": "H2 font weight" },
      "line-height":    { "$value": "{line-height.tight}",           "$type": "number",    "$description": "H2 line height" },
      "color":          { "$value": "{text.heading.color}",          "$type": "color",     "$description": "H2 color" },
      "letter-spacing": { "$value": "{text.heading.letter-spacing}", "$type": "dimension", "$description": "H2 letter spacing" },
      "surface-dark-color": { "$value": "{color.text.on-dark}", "$type": "color", "$description": "H2 color — surface-dark" }
    },

    "h3": {
      "font-family":    { "$value": "{text.heading.font-family}",    "$type": "string",    "$description": "H3 font family" },
      "font-size":      { "$value": "{text.size.6}",                 "$type": "dimension", "$description": "H3 font size — paso 6 de la escala (28px en base, un peldaño más en la superficie pública)" },
      "font-weight":    { "$value": "{text.heading.font-weight}",    "$type": "number",    "$description": "H3 font weight" },
      "line-height":    { "$value": "{line-height.tight}",           "$type": "number",    "$description": "H3 line height" },
      "color":          { "$value": "{text.heading.color}",          "$type": "color",     "$description": "H3 color" },
      "letter-spacing": { "$value": "{text.heading.letter-spacing}", "$type": "dimension", "$description": "H3 letter spacing" },
      "surface-dark-color": { "$value": "{color.text.on-dark}", "$type": "color", "$description": "H3 color — surface-dark" }
    },

    "h4": {
      "font-family":    { "$value": "{text.heading.font-family}",    "$type": "string",    "$description": "H4 font family" },
      "font-size":      { "$value": "{text.size.5}",                 "$type": "dimension", "$description": "H4 font size — paso 5 de la escala (24px en base, un peldaño más en la superficie pública)" },
      "font-weight":    { "$value": "{text.heading.font-weight}",    "$type": "number",    "$description": "H4 font weight" },
      "line-height":    { "$value": "{line-height.snug}",            "$type": "number",    "$description": "H4 line height" },
      "color":          { "$value": "{text.heading.color}",          "$type": "color",     "$description": "H4 color" },
      "letter-spacing": { "$value": "{text.heading.letter-spacing}", "$type": "dimension", "$description": "H4 letter spacing" },
      "surface-dark-color": { "$value": "{color.text.on-dark}", "$type": "color", "$description": "H4 color — surface-dark" }
    },

    "h5": {
      "font-family":    { "$value": "{text.heading.font-family}",    "$type": "string",    "$description": "H5 font family" },
      "font-size":      { "$value": "{text.size.4}",                 "$type": "dimension", "$description": "H5 font size — paso 4 de la escala (20px en base, un peldaño más en la superficie pública)" },
      "font-weight":    { "$value": "{text.heading.font-weight}",    "$type": "number",    "$description": "H5 font weight" },
      "line-height":    { "$value": "{line-height.snug}",            "$type": "number",    "$description": "H5 line height" },
      "color":          { "$value": "{text.heading.color}",          "$type": "color",     "$description": "H5 color" },
      "letter-spacing": { "$value": "{letter-spacing.normal}",       "$type": "dimension", "$description": "H5 letter spacing" },
      "surface-dark-color": { "$value": "{color.text.on-dark}", "$type": "color", "$description": "H5 color — surface-dark" }
    },

    "h6": {
      "font-family":    { "$value": "{text.heading.font-family}",    "$type": "string",    "$description": "H6 font family" },
      "font-size":      { "$value": "{text.size.3}",                 "$type": "dimension", "$description": "H6 font size — paso 3 de la escala (16px en base, un peldaño más en la superficie pública)" },
      "font-weight":    { "$value": "{text.heading.font-weight}",    "$type": "number",    "$description": "H6 font weight" },
      "line-height":    { "$value": "{line-height.snug}",            "$type": "number",    "$description": "H6 line height" },
      "color":          { "$value": "{text.heading.color}",          "$type": "color",     "$description": "H6 color" },
      "letter-spacing": { "$value": "{letter-spacing.normal}",       "$type": "dimension", "$description": "H6 letter spacing" },
      "surface-dark-color": { "$value": "{color.text.on-dark}", "$type": "color", "$description": "H6 color — surface-dark" }
    },

    "paragraph": {
      "small": {
        "font-size":   { "$value": "{font-size.1}",          "$type": "dimension", "$description": "Párrafo pequeño: un peldaño por debajo del cuerpo (14px en base, 16px en la superficie pública)" },
        "line-height": { "$value": "{line-height.relaxed}",  "$type": "number",    "$description": "Small paragraph line height" }
      },
      "large": {
        "font-size":   { "$value": "{font-size.3}",          "$type": "dimension", "$description": "Párrafo grande: un peldaño por encima del cuerpo (20px en base, 24px en la superficie pública)" },
        "line-height": { "$value": "{line-height.snug}",     "$type": "number",    "$description": "Large paragraph line height" }
      }
    },

    "list": {
      "font-family":          { "$value": "{text.font-family}",    "$type": "string",    "$description": "List font family" },
      "font-size":            { "$value": "{text.font-size}",      "$type": "dimension", "$description": "List font size" },
      "font-weight":          { "$value": "{text.font-weight}",    "$type": "number",    "$description": "List font weight" },
      "line-height":          { "$value": "{text.line-height}",    "$type": "number",    "$description": "List line height" },
      "color":                { "$value": "{text.color}",          "$type": "color",     "$description": "List text color" },
      "letter-spacing":       { "$value": "{text.letter-spacing}", "$type": "dimension", "$description": "List letter spacing" },
      "gap":                  { "$value": "{spacing.2}",                     "$type": "dimension", "$description": "Spacing between list items (8px)" },
      "padding-inline-start": { "$value": "{spacing.6}",                     "$type": "dimension", "$description": "Left indent for list (32px)" },
      "surface-dark-color": { "$value": "{color.text.on-dark}", "$type": "color", "$description": "List color — surface-dark" }
    }
  }
}
