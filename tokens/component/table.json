{
  "table": {
    "font-family":         { "$value": "{font-family.sans}",          "$type": "string",    "$description": "Font family" },
    "font-size":           { "$value": "{text.font-size}",            "$type": "dimension", "$description": "Las celdas heredan el cuerpo de la superficie (16px en aplicación, 20px en la pública)" },
    "font-weight":         { "$value": "{font-weight.default}",       "$type": "number",    "$description": "Font weight base" },
    "line-height":         { "$value": "{text.line-height}",          "$type": "number",    "$description": "Interlineado heredado del cuerpo de la superficie, para celdas multilínea" },
    "color":               { "$value": "{color.text.on-light}",       "$type": "color",     "$description": "Color de texto base" },
    "bg":                  { "$value": "transparent",                 "$type": "color",     "$description": "Fondo de la tabla" },

    "border-width":        { "$value": "{border-width.default}",           "$type": "dimension", "$description": "Grosor de separadores de fila" },

    "header-padding-block":   { "$value": "{spacing.3}",              "$type": "dimension", "$description": "Padding block del encabezado" },
    "header-padding-inline":  { "$value": "{spacing.3}",              "$type": "dimension", "$description": "Padding inline del encabezado" },
    "header-font-weight":     { "$value": "{font-weight.emphasis}",   "$type": "number",    "$description": "Peso tipográfico del encabezado" },
    "header-border-width":    { "$value": "{border-width.default}",        "$type": "dimension", "$description": "Borde inferior del thead — 1px, como todo borde del sistema; la cabecera se lee por peso, no por grosor" },
    "header-content-gap":     { "$value": "{spacing.2}",              "$type": "dimension", "$description": "Separación entre el rótulo de la columna y el icono de ordenación" },
    "header-border-color":    { "$value": "{color.text.on-light}",    "$type": "color",     "$description": "Color del borde inferior del thead" },

    "sort-icon-color":         { "$value": "{color.text.muted-on-light}", "$type": "color", "$description": "Icono de ordenación en reposo, tinta plana; el hover lo lleva al color activo" },
    "sort-icon-active-color":  { "$value": "{color.primary}",         "$type": "color",     "$description": "Color del icono de sort activo" },

    "cell-padding-block":     { "$value": "{spacing.3}",              "$type": "dimension", "$description": "Padding block de celda" },
    "cell-padding-inline":    { "$value": "{spacing.3}",              "$type": "dimension", "$description": "Padding inline de celda" },

    "row-border-color":       { "$value": "{color.primary}",       "$type": "color",     "$description": "Color del separador entre filas" },
    "row-selected-color":     { "$value": "{color.primary}",          "$type": "color",     "$description": "Tinta de la fila seleccionada: la selección se dice con tinta y peso, no con un fondo gris" },
    "row-hover-marker-width": { "$value": "{border-width.focus}",     "$type": "dimension", "$description": "Grosor de la barra que marca la fila bajo el puntero. El hover no pinta relleno (regla de Colores): la fila se señala con una barra de tinta en su borde de inicio, el mismo grafismo que la sección activa del SidebarNav en rail" },
    "row-hover-marker-color": { "$value": "{color.primary}",          "$type": "color",     "$description": "Color de la barra de hover — tinta de la superficie" },
    "row-selected-font-weight": { "$value": "{font-weight.emphasis}", "$type": "number",    "$description": "Peso de la fila seleccionada" },

    "footer-bg":              { "$value": "{color.surface.secondary-on-light}", "$type": "color", "$description": "Fondo del tfoot: superficie clara secundaria, no un fondo de estado" },
    "footer-border-width":    { "$value": "{border-width.default}",        "$type": "dimension", "$description": "Borde superior del tfoot — 1px, como el del thead" },
    "footer-border-color":    { "$value": "{color.text.on-light}",    "$type": "color",     "$description": "Color del borde superior del tfoot" },
    "footer-font-weight":     { "$value": "{font-weight.emphasis}",     "$type": "number",    "$description": "Peso tipográfico de las celdas del footer" },

    "focus-ring-color":       { "$value": "{color.primary}",          "$type": "color",     "$description": "Color del focus ring" },
    "focus-ring-width":       { "$value": "{border-width.focus}",        "$type": "dimension", "$description": "Grosor del focus ring" },
    "focus-ring-offset":      { "$value": "{border-width.default}",        "$type": "dimension", "$description": "Separación del focus ring" },

    "transition-duration":    { "$value": "{motion.duration.fast}",   "$type": "number",    "$description": "Duración de transiciones de hover" },
    "transition-easing":      { "$value": "{motion.easing.default}",  "$type": "string",    "$description": "Easing de transiciones" },

    "sm-font-size":             { "$value": "{font-size.1}",            "$type": "dimension", "$description": "14px — UI label size — variante sm" },
    "sm-header-padding-block":  { "$value": "{spacing.2}",            "$type": "dimension", "$description": "Padding block del encabezado — variante sm" },
    "sm-header-padding-inline": { "$value": "{spacing.2}",            "$type": "dimension", "$description": "Padding inline del encabezado — variante sm" },
    "sm-cell-padding-block":    { "$value": "{spacing.2}",            "$type": "dimension", "$description": "Padding block de celda — variante sm" },
    "sm-cell-padding-inline":   { "$value": "{spacing.2}",            "$type": "dimension", "$description": "Padding inline de celda — variante sm" },
    "surface-dark-color":              { "$value": "{color.text.on-dark}",       "$type": "color", "$description": "Color de texto base — surface-dark" },
    "surface-dark-header-border-color":{ "$value": "{color.text.on-dark}",       "$type": "color", "$description": "Borde inferior del thead — surface-dark" },
    "surface-dark-sort-icon-color":       { "$value": "{color.text.muted-on-dark}", "$type": "color", "$description": "Icono de sort inactivo — surface-dark" },
    "surface-dark-sort-icon-active-color":{ "$value": "{color.text.on-dark}",       "$type": "color", "$description": "Icono de sort activo — surface-dark" },
    "surface-dark-row-border-color":   { "$value": "{color.text.on-dark}",  "$type": "color", "$description": "Separador entre filas — surface-dark" },
    "surface-dark-row-selected-color": { "$value": "{color.accent-1}",          "$type": "color", "$description": "Tinta de la fila seleccionada — surface-dark: lavanda, como en el SidebarNav" },
    "surface-dark-footer-bg":          { "$value": "{color.surface.secondary-on-dark}", "$type": "color", "$description": "Fondo del tfoot — surface-dark" },
    "surface-dark-footer-border-color":{ "$value": "{color.text.on-dark}",       "$type": "color", "$description": "Borde superior del tfoot — surface-dark" },
    "surface-dark-focus-ring-color":   { "$value": "{color.text.on-dark}",       "$type": "color", "$description": "Focus ring color — surface-dark" },
    "surface-dark-row-hover-marker-color": { "$value": "{color.text.on-dark}", "$type": "color", "$description": "Color de la barra de hover — surface-dark" }
  }
}
