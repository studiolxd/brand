{
  "pagination": {
    "font-family":         { "$value": "{font-family.sans}",          "$type": "string",    "$description": "Font family" },
    "font-size":           { "$value": "{font-size.2}",               "$type": "dimension", "$description": "16px — texto del nav (sumario) en la talla md" },
    "font-weight":         { "$value": "{font-weight.default}",       "$type": "number",    "$description": "Font weight base" },
    "line-height":         { "$value": "{line-height.none}",          "$type": "number",    "$description": "Single line" },
    "gap":                 { "$value": "{spacing.3}",                 "$type": "dimension", "$description": "Gap entre secciones del nav" },
    "controls-gap":        { "$value": "{spacing.1}",                 "$type": "dimension", "$description": "Gap entre botones de paginación" },
    "padding-block":       { "$value": "{spacing.1}",                 "$type": "dimension", "$description": "Padding vertical del nav" },
    "padding-inline":      { "$value": "0",                           "$type": "dimension", "$description": "Sin padding lateral" },
    "summary-color":       { "$value": "{color.text.on-light}",       "$type": "color",     "$description": "Color del texto de total de resultados" },

    "btn-height":              { "$value": "{button.height}",             "$type": "dimension", "$description": "Altura del botón de página — la del `Button md` (40px). También su lado mínimo: la caja es cuadrada" },
    "btn-font-size":           { "$value": "{button.font-size}",          "$type": "dimension", "$description": "Tipografía del botón de página — la del `Button md`" },
    "btn-padding-inline":      { "$value": "{spacing.2}",                 "$type": "dimension", "$description": "Padding horizontal del botón: el inset interior del control, no el del rótulo de un `Button` (aquí el rótulo es una cifra y la caja ya es cuadrada por `btn-height`); solo entra en juego cuando el número tiene tres o más dígitos" },
    "btn-radius":              { "$value": "{button.border-radius}",      "$type": "dimension", "$description": "Radio de borde del botón — el del `Button`" },
    "btn-border-width":        { "$value": "{button.border-width}",       "$type": "dimension", "$description": "Grosor del borde del botón (1px) — el del `Button`" },
    "btn-border-style":        { "$value": "{button.border-style}",       "$type": "string",    "$description": "Estilo del borde del botón — el del `Button`" },
    "btn-bg":                  { "$value": "transparent",                 "$type": "color",     "$description": "Relleno en reposo: ninguno — es un botón outline" },
    "btn-color":               { "$value": "{color.primary}",             "$type": "color",     "$description": "Tinta del botón en reposo" },
    "btn-border-color":        { "$value": "{color.primary}",             "$type": "color",     "$description": "Borde del botón en reposo" },
    "btn-hover-bg":            { "$value": "{color.primary}",             "$type": "color",     "$description": "Relleno en hover — el outline se invierte, sin subrayado" },
    "btn-hover-color":         { "$value": "{color.text.on-dark}",        "$type": "color",     "$description": "Tinta en hover" },
    "btn-hover-border-color":  { "$value": "{color.primary}",             "$type": "color",     "$description": "Borde en hover" },
    "btn-current-bg":          { "$value": "{color.primary}",             "$type": "color",     "$description": "Relleno de la página activa: el mismo dibujo que el hover" },
    "btn-current-color":       { "$value": "{color.text.on-dark}",        "$type": "color",     "$description": "Tinta de la página activa" },
    "btn-current-border-color":{ "$value": "{color.primary}",             "$type": "color",     "$description": "Borde de la página activa" },
    "btn-current-font-weight": { "$value": "{font-weight.emphasis}",      "$type": "number",    "$description": "Peso tipográfico de la página activa" },
    "btn-disabled-bg":         { "$value": "transparent",                 "$type": "color",     "$description": "Relleno cuando está deshabilitado: ninguno" },
    "btn-disabled-color":      { "$value": "{color.disabled.border-on-light}", "$type": "color", "$description": "Tinta cuando está deshabilitado — el mismo rol que el `Button outline`" },
    "btn-disabled-border-color":{ "$value": "{color.disabled.border-on-light}", "$type": "color", "$description": "Borde cuando está deshabilitado — el mismo rol que el `Button outline`" },
    "btn-disabled-cursor":     { "$value": "not-allowed",                 "$type": "string",    "$description": "Cursor cuando está deshabilitado" },

    "ellipsis-color":      { "$value": "{color.text.muted-on-light}", "$type": "color",     "$description": "Color del ellipsis" },
    "focus-ring-color":    { "$value": "{color.primary}",             "$type": "color",     "$description": "Color del focus ring" },
    "focus-ring-width":    { "$value": "{border-width.focus}",        "$type": "dimension", "$description": "Grosor del focus ring" },
    "focus-ring-offset":   { "$value": "{border-width.default}",      "$type": "dimension", "$description": "Separación del focus ring" },
    "transition-duration": { "$value": "{motion.duration.fast}",      "$type": "number",    "$description": "Duración de las transiciones" },
    "transition-easing":   { "$value": "{motion.easing.default}",     "$type": "string",    "$description": "Easing de las transiciones" },

    "sm-font-size":          { "$value": "{font-size.1}",          "$type": "dimension", "$description": "Texto del nav — talla sm" },
    "sm-btn-height":         { "$value": "{button.sm-height}",     "$type": "dimension", "$description": "Altura y lado mínimo del botón — la del `Button sm` (32px)" },
    "sm-btn-font-size":      { "$value": "{button.sm-font-size}",  "$type": "dimension", "$description": "Tipografía del botón — la del `Button sm`" },
    "sm-btn-padding-inline": { "$value": "{spacing.1}",            "$type": "dimension", "$description": "Padding horizontal del botón — talla sm" },

    "lg-font-size":          { "$value": "{font-size.3}",          "$type": "dimension", "$description": "Texto del nav — talla lg (la pública)" },
    "lg-btn-height":         { "$value": "{button.lg-height}",     "$type": "dimension", "$description": "Altura y lado mínimo del botón — la del `Button lg` (48px)" },
    "lg-btn-font-size":      { "$value": "{button.lg-font-size}",  "$type": "dimension", "$description": "Tipografía del botón — la del `Button lg`" },
    "lg-btn-padding-inline": { "$value": "{spacing.3}",            "$type": "dimension", "$description": "Padding horizontal del botón — talla lg" },

    "surface-dark-summary-color":       { "$value": "{color.text.on-dark}",       "$type": "color", "$description": "Color del resumen — surface-dark" },
    "surface-dark-btn-color":           { "$value": "{color.text.on-dark}",       "$type": "color", "$description": "Tinta del botón en reposo — surface-dark" },
    "surface-dark-btn-border-color":    { "$value": "{color.text.on-dark}",       "$type": "color", "$description": "Borde del botón en reposo — surface-dark" },
    "surface-dark-btn-hover-bg":        { "$value": "{color.text.on-dark}",       "$type": "color", "$description": "Relleno en hover — surface-dark: el blanco puro, como el `Button outline`" },
    "surface-dark-btn-hover-color":     { "$value": "{color.primary}",            "$type": "color", "$description": "Tinta en hover — surface-dark" },
    "surface-dark-btn-hover-border-color": { "$value": "{color.text.on-dark}",    "$type": "color", "$description": "Borde en hover — surface-dark" },
    "surface-dark-btn-current-bg":      { "$value": "{color.text.on-dark}",       "$type": "color", "$description": "Relleno de la página activa — surface-dark" },
    "surface-dark-btn-current-color":   { "$value": "{color.primary}",            "$type": "color", "$description": "Tinta de la página activa — surface-dark" },
    "surface-dark-btn-current-border-color": { "$value": "{color.text.on-dark}",  "$type": "color", "$description": "Borde de la página activa — surface-dark" },
    "surface-dark-btn-disabled-color":  { "$value": "{color.disabled.border-on-dark}", "$type": "color", "$description": "Tinta deshabilitada — surface-dark" },
    "surface-dark-btn-disabled-border-color": { "$value": "{color.disabled.border-on-dark}", "$type": "color", "$description": "Borde deshabilitado — surface-dark" },
    "surface-dark-ellipsis-color":      { "$value": "{color.text.muted-on-dark}", "$type": "color", "$description": "Color del ellipsis — surface-dark" },
    "surface-dark-focus-ring-color":    { "$value": "{color.text.on-dark}",       "$type": "color", "$description": "Focus ring color — surface-dark" }
  }
}
