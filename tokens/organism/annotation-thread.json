{
  "annotation-thread": {
    "gap":                    { "$value": "{spacing.4}",              "$type": "dimension", "$description": "Separación entre las piezas del hilo" },
    "border-width":           { "$value": "{border-width.default}",   "$type": "dimension", "$description": "Grosor del borde del hilo" },
    "border-color":           { "$value": "{color.border.default-on-light}", "$type": "color",     "$description": "Borde del hilo" },
    "padding-block":          { "$value": "{spacing.4}",              "$type": "dimension", "$description": "Aire vertical del hilo" },
    "padding-inline":         { "$value": "{spacing.4}",              "$type": "dimension", "$description": "Aire horizontal del hilo" },
    "reply-indent":           { "$value": "{spacing.5}",              "$type": "dimension", "$description": "Sangría de las respuestas respecto a la anotación que abre el hilo" },
    "reply-guide-width":      { "$value": "{border-width.default}",   "$type": "dimension", "$description": "Grosor de la guía que acompaña a las respuestas" },
    "reply-guide-color":      { "$value": "{color.border.default-on-light}", "$type": "color",     "$description": "Color de la guía de respuestas" },
    "item-gap":               { "$value": "{spacing.2}",              "$type": "dimension", "$description": "Separación entre la cabecera, el cuerpo y las acciones de una anotación" },
    "items-gap":              { "$value": "{spacing.4}",              "$type": "dimension", "$description": "Separación entre anotaciones" },
    "header-gap":             { "$value": "{spacing.2}",              "$type": "dimension", "$description": "Separación entre autor, fecha y marca de editada" },
    "author-font-family":     { "$value": "{control.font-family}",    "$type": "string",    "$description": "Familia del autor" },
    "author-font-size":       { "$value": "{text.paragraph.small.font-size}", "$type": "dimension", "$description": "Tamaño del autor: la letra menor del texto corriente" },
    "author-font-weight":     { "$value": "{font-weight.emphasis}",   "$type": "number",    "$description": "Peso del autor" },
    "author-color":           { "$value": "{color.text.on-light}",    "$type": "color",     "$description": "Tinta del autor" },
    "meta-font-size":         { "$value": "{text.paragraph.small.font-size}", "$type": "dimension", "$description": "Tamaño de la fecha y de la marca de editada" },
    "meta-color":             { "$value": "{color.text.muted-on-light}", "$type": "color",  "$description": "Tinta de la fecha y de la marca de editada" },
    "body-font-size":         { "$value": "{text.font-size}",         "$type": "dimension", "$description": "Tamaño del cuerpo: es texto corriente" },
    "body-line-height":       { "$value": "{text.line-height}",       "$type": "number",    "$description": "Interlineado del cuerpo" },
    "body-color":             { "$value": "{color.text.on-light}",    "$type": "color",     "$description": "Tinta del cuerpo" },
    "replies-label-font-size":{ "$value": "{text.paragraph.small.font-size}", "$type": "dimension", "$description": "Tamaño del rótulo que cuenta las respuestas" },
    "replies-label-color":    { "$value": "{color.text.muted-on-light}", "$type": "color",  "$description": "Tinta del rótulo que cuenta las respuestas" },
    "resolved-opacity":       { "$value": "{opacity.disabled}",       "$type": "number",    "$description": "Un hilo resuelto se retira: baja de intensidad sin desaparecer" },
    "surface-dark-border-color":       { "$value": "{color.text.on-dark}",      "$type": "color", "$description": "Borde del hilo — surface-dark" },
    "surface-dark-reply-guide-color":  { "$value": "{color.text.on-dark}",      "$type": "color", "$description": "Guía de respuestas — surface-dark" },
    "surface-dark-author-color":       { "$value": "{color.text.on-dark}",      "$type": "color", "$description": "Tinta del autor — surface-dark" },
    "surface-dark-meta-color":         { "$value": "{color.text.muted-on-dark}","$type": "color", "$description": "Tinta de la fecha — surface-dark" },
    "surface-dark-body-color":         { "$value": "{color.text.on-dark}",      "$type": "color", "$description": "Tinta del cuerpo — surface-dark" },
    "surface-dark-replies-label-color":{ "$value": "{color.text.muted-on-dark}","$type": "color", "$description": "Tinta del rótulo de respuestas — surface-dark" }
  }
}
