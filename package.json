  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "rm -rf dist && vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json && node scripts/post-build.mjs",
    "build:css": "postcss src/index.css --use postcss-import -o dist/brand.css",
    "build:tokens-css": "postcss src/tokens/index.css --use postcss-import -o dist/tokens.css",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:tokens": "node sd.config.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "npx chromatic",
    "test": "vitest run --project unit --project components",
    "test:stories": "vitest run --project storybook",
    "build:all": "pnpm build:tokens && pnpm build:lib && pnpm build:css && pnpm build:tokens-css"
  },
